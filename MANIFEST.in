include README.md
include requirements.txt
graft docs
exclude docs/*.html
graft bikeshed
prune bikeshed/.mypy_cache
prune bikeshed/spec-data
graft bikeshed/spec-data/readonly
exclude bikeshed/semver-dev.txt
exclude bikeshed/test.bs bikeshed/test.html bikeshed/test.bsi
global-exclude *.py[cod] __pycache__
