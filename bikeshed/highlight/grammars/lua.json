{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "builtins": {
      "match": "\\b(?:assert|collectgarbage|dofile|error|getmetatable|ipairs|load|loadstring|next|pairs|pcall|print|rawequal|rawget|rawlen|rawset|require|select|setmetatable|tonumber|tostring|type|unpack|xpcall|table|string|math|os|io|coroutine)\\b",
      "name": "support.class.builtin"
    },
    "comments": {
      "patterns": [
        {
          "begin": "--\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "name": "comment.block"
        },
        {
          "match": "--.*$",
          "name": "comment.line.double-dash"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:true|false)\\b",
          "name": "constant.language.boolean"
        },
        {
          "match": "\\bnil\\b",
          "name": "constant.language"
        },
        {
          "match": "\\bself\\b",
          "name": "variable.language.lua"
        }
      ]
    },
    "function-declaration": {
      "captures": {
        "1": {
          "name": "storage.type.function"
        },
        "2": {
          "name": "entity.name.function"
        }
      },
      "match": "\\b(function)\\s+([A-Za-z_][\\w.:]*)"
    },
    "keywords": {
      "match": "\\b(?:and|break|do|else|elseif|end|for|function|goto|if|in|local|not|or|repeat|return|then|until|while)\\b",
      "name": "keyword.control"
    },
    "numbers": {
      "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F]+(?:\\.[0-9a-fA-F]*)?(?:[pP][+-]?\\d+)?|(?:\\d+\\.\\d*|\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "(?:\\.\\.\\.|\\.\\.|==|~=|<=|>=|::|[+\\-*/%^#&~|<>=])",
      "name": "keyword.operator"
    },
    "strings": {
      "patterns": [
        {
          "begin": "\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "name": "string.quoted.other.multiline"
        },
        {
          "match": "\"(?:\\\\.|[^\"\\\\\\r\\n])*\"",
          "name": "string.quoted.double"
        },
        {
          "match": "'(?:\\\\.|[^'\\\\\\r\\n])*'",
          "name": "string.quoted.single"
        }
      ]
    }
  },
  "scopeName": "source.lua"
}
