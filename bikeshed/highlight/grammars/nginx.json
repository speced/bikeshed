{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#block-delimiters"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "block-delimiters": {
      "match": "[{};]",
      "name": "punctuation.section.block"
    },
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign"
    },
    "directives": {
      "captures": {
        "1": {
          "name": "keyword.other.directive"
        }
      },
      "match": "^\\s*([A-Za-z_][\\w-]*)\\s*(?=\\S)"
    },
    "keywords": {
      "match": "\\b(?:on|off|yes|no|default|auto|none|http|https|tcp|udp|unix|listen|server_name|proxy_pass|root|index|rewrite|return|include|location|upstream|server)\\b",
      "name": "keyword"
    },
    "numbers": {
      "match": "(?<![\\w.])[-+]?\\d+(?:\\.\\d+)?(?:[kKmMgG]?)\\b",
      "name": "constant.numeric"
    },
    "strings": {
      "patterns": [
        {
          "match": "\"(?:\\\\.|[^\"\\\\])*\"",
          "name": "string.quoted.double"
        },
        {
          "match": "'(?:\\\\.|[^'\\\\])*'",
          "name": "string.quoted.single"
        }
      ]
    },
    "variables": {
      "match": "\\$[A-Za-z_][\\w-]*|\\$\\{[^}]+\\}",
      "name": "variable.other"
    }
  },
  "scopeName": "source.nginx"
}
