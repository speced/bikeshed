{
  "dependencies": [
    "html",
    "css",
    "scss",
    "javascript",
    "typescript"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#typescript"
    },
    {
      "include": "#javascript"
    },
    {
      "include": "#scss"
    },
    {
      "include": "#css"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#tags"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "comments": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block"
    },
    "css": {
      "begin": "<(style)\\b[^>]*>",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "contentName": "source.css.embedded.vue",
      "end": "</(style)\\s*>",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "patterns": [
        {
          "include": "source.css"
        }
      ]
    },
    "directive": {
      "captures": {
        "1": {
          "name": "entity.other.attribute-name"
        }
      },
      "match": "[ \\t]+((?:v-[\\w-]+(?::[\\w-]+)?|[:@#][\\w-]+)(?:\\.[\\w-]+)*)"
    },
    "directive-value": {
      "begin": "[ \\t]+((?:v-[\\w-]+(?::[\\w-]+)?|[:@#][\\w-]+)(?:\\.[\\w-]+)*)\\s*=\\s*(['\"])",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name"
        },
        "2": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "contentName": "source.js.embedded.vue",
      "end": "\\2",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "interpolation": {
      "begin": "\\{\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin"
        }
      },
      "contentName": "source.js.embedded.vue",
      "end": "\\}\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end"
        }
      },
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "javascript": {
      "begin": "<(script)\\b[^>]*>",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "contentName": "source.js.embedded.vue",
      "end": "</(script)\\s*>",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "scss": {
      "begin": "<(style)\\b(?=[^>]*\\blang\\s*=\\s*(['\"])scss\\2)[^>]*>",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "contentName": "source.css.scss.embedded.vue",
      "end": "</(style)\\s*>",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "patterns": [
        {
          "include": "source.scss"
        }
      ]
    },
    "tags": {
      "begin": "<(/?)([a-zA-Z][\\w.:-]*)",
      "beginCaptures": {
        "2": {
          "name": "entity.name.tag"
        }
      },
      "end": ">",
      "patterns": [
        {
          "include": "#directive-value"
        },
        {
          "include": "#directive"
        },
        {
          "include": "text.html.basic#inline-css"
        },
        {
          "include": "text.html.basic#attributes"
        },
        {
          "include": "text.html.basic#unquoted-attributes"
        },
        {
          "include": "text.html.basic#boolean-attributes"
        }
      ]
    },
    "typescript": {
      "begin": "<(script)\\b(?=[^>]*\\blang\\s*=\\s*(['\"])(?:ts|typescript)\\2)[^>]*>",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "contentName": "source.ts.embedded.vue",
      "end": "</(script)\\s*>",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "patterns": [
        {
          "include": "source.ts"
        }
      ]
    }
  },
  "scopeName": "text.html.vue"
}
