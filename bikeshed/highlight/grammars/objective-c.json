{
  "dependencies": [
    "c"
  ],
  "patterns": [
    {
      "include": "source.c#comments"
    },
    {
      "include": "source.c#preprocessor"
    },
    {
      "include": "#interface-declaration"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#nsstring"
    },
    {
      "include": "source.c#strings"
    },
    {
      "include": "#method-declaration"
    },
    {
      "include": "#language-variables"
    },
    {
      "include": "source.c#storage-types"
    },
    {
      "include": "source.c#keywords"
    },
    {
      "include": "#property-attributes"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "source.c#builtin-types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "source.c#constants"
    },
    {
      "include": "source.c#numbers"
    },
    {
      "include": "source.c#operators"
    },
    {
      "include": "source.c#function-declaration"
    }
  ],
  "repository": {
    "builtin-types": {
      "match": "\\b(?:id|instancetype|BOOL|SEL|Class|IMP|NSInteger|NSUInteger|CGFloat|NSString|NSMutableString|NSArray|NSMutableArray|NSDictionary|NSMutableDictionary|NSNumber|NSObject|NSError|NSData|NSURL|NSNotification)\\b",
      "name": "support.class.builtin"
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:YES|NO)\\b",
          "name": "constant.language.boolean"
        },
        {
          "match": "\\b(?:nil|Nil)\\b",
          "name": "constant.language"
        }
      ]
    },
    "directives": {
      "match": "@(?:end|property|synthesize|dynamic|optional|required|class|import|selector|encode|synchronized|autoreleasepool|try|catch|finally|throw)\\b",
      "name": "keyword.control.directive.objc"
    },
    "interface-declaration": {
      "captures": {
        "1": {
          "name": "storage.type.class"
        },
        "2": {
          "name": "entity.name.type.class"
        }
      },
      "match": "\\b(@interface|@implementation|@protocol)\\s+([A-Za-z_]\\w*)"
    },
    "language-variables": {
      "match": "\\b(?:self|super)\\b",
      "name": "variable.language.objc"
    },
    "method-declaration": {
      "captures": {
        "1": {
          "name": "entity.name.function"
        }
      },
      "match": "^\\s*[-+]\\s*\\([^)]*\\)\\s*([A-Za-z_]\\w*)"
    },
    "nsstring": {
      "match": "@\"(?:\\\\.|[^\"\\\\])*\"",
      "name": "string.quoted.double"
    },
    "property-attributes": {
      "match": "\\b(?:nonatomic|atomic|strong|weak|copy|assign|retain|readonly|readwrite|unsafe_unretained|nullable|nonnull|null_resettable)\\b",
      "name": "storage.modifier"
    }
  },
  "scopeName": "source.objc"
}
