{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#class-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function-declaration"
    }
  ],
  "repository": {
    "annotations": {
      "match": "@[A-Za-z_][\\w]*",
      "name": "entity.name.decorator"
    },
    "builtin-types": {
      "match": "\\b(?:int|double|num|bool|String|List|Map|Set|Object|Future|Stream|Iterable|Duration|DateTime|Symbol|Never|Function)\\b",
      "name": "support.class.builtin"
    },
    "class-declaration": {
      "captures": {
        "1": {
          "name": "storage.type.class"
        },
        "2": {
          "name": "entity.name.type.class"
        }
      },
      "match": "\\b(class|enum|mixin|extension)\\s+([A-Za-z_]\\w*)"
    },
    "comments": {
      "patterns": [
        {
          "match": "///.*$",
          "name": "comment.line.documentation"
        },
        {
          "match": "//.*$",
          "name": "comment.line.double-slash"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:true|false)\\b",
          "name": "constant.language.boolean"
        },
        {
          "match": "\\bnull\\b",
          "name": "constant.language"
        }
      ]
    },
    "function-declaration": {
      "match": "\\b([A-Za-z_]\\w*)(?=\\s*(?:<[^>]*>)?\\s*\\()",
      "name": "entity.name.function"
    },
    "keywords": {
      "match": "\\b(?:abstract|as|assert|async|await|break|case|catch|const|continue|covariant|default|deferred|do|dynamic|else|export|extends|external|factory|final|finally|for|get|hide|if|implements|import|in|interface|is|late|library|new|on|operator|part|required|rethrow|return|set|show|static|super|switch|sync|this|throw|try|typedef|var|void|while|with|yield)\\b",
      "name": "keyword.control"
    },
    "numbers": {
      "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "(?:=>|\\?\\?=?|\\?\\.|\\.\\.\\.\\??|\\.\\.|&&|\\|\\||==|!=|<=|>=|[+\\-*/%!<>=~^&|]=?)",
      "name": "keyword.operator"
    },
    "strings": {
      "patterns": [
        {
          "begin": "r?\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple.double"
        },
        {
          "begin": "r?'''",
          "end": "'''",
          "name": "string.quoted.triple.single"
        },
        {
          "match": "r?\"(?:\\\\.|[^\"\\\\\\r\\n])*\"",
          "name": "string.quoted.double"
        },
        {
          "match": "r?'(?:\\\\.|[^'\\\\\\r\\n])*'",
          "name": "string.quoted.single"
        }
      ]
    }
  },
  "scopeName": "source.dart"
}
