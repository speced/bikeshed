{
  "dependencies": [
    "html",
    "elixir"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#eex"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "attributes": {
      "begin": "[ \\t]+([:@a-zA-Z_][\\w:.-]*)\\s*=\\s*(['\"])",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name"
        },
        "2": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "contentName": "string.quoted.attribute-value",
      "end": "\\2",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "text.html.basic#entities"
        }
      ]
    },
    "comments": {
      "begin": "<%!--",
      "end": "--%>",
      "name": "comment.block"
    },
    "eex": {
      "begin": "<%(?:[=#]|\\|)?",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin"
        }
      },
      "contentName": "source.elixir.embedded.heex",
      "end": "%>",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end"
        }
      },
      "patterns": [
        {
          "include": "source.elixir"
        }
      ]
    },
    "expression-attribute": {
      "begin": "[ \\t]+([:@a-zA-Z_][\\w:.-]*)\\s*=\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name"
        }
      },
      "contentName": "source.elixir.embedded.heex",
      "end": "\\}",
      "patterns": [
        {
          "include": "source.elixir"
        }
      ]
    },
    "interpolation": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin"
        }
      },
      "contentName": "source.elixir.embedded.heex",
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end"
        }
      },
      "patterns": [
        {
          "include": "source.elixir"
        }
      ]
    },
    "shorthand-attribute": {
      "begin": "[ \\t]+\\{",
      "contentName": "source.elixir.embedded.heex",
      "end": "\\}",
      "patterns": [
        {
          "include": "source.elixir"
        }
      ]
    },
    "tags": {
      "begin": "<(/?)([a-zA-Z.:][\\w.:-]*)",
      "beginCaptures": {
        "2": {
          "name": "entity.name.tag"
        }
      },
      "end": ">",
      "patterns": [
        {
          "include": "#expression-attribute"
        },
        {
          "include": "#shorthand-attribute"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "text.html.basic#unquoted-attributes"
        },
        {
          "include": "text.html.basic#boolean-attributes"
        }
      ]
    }
  },
  "scopeName": "text.html.heex"
}
