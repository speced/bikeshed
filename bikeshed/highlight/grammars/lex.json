{
  "scopeName": "source.lex",
  "name": "Lex",
  "fileTypes": [
    "l",
    "lex",
    "flex"
  ],
  "dependencies": [
    "cpp",
    "lex-regexp"
  ],
  "patterns": [
    {
      "include": "#main"
    }
  ],
  "repository": {
    "main": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#passthrough"
        },
        {
          "include": "#rules"
        },
        {
          "include": "#user-code"
        },
        {
          "include": "#directives"
        },
        {
          "include": "#definition"
        }
      ]
    },
    "balanced-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#balanced-braces"
        },
        {
          "include": "source.cpp"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.lex",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.begin.comment.lex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.end.comment.lex"
            }
          }
        },
        {
          "name": "comment.line.double-slash.lex",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.lex"
            }
          }
        }
      ]
    },
    "definition": {
      "name": "meta.definition.lex",
      "begin": "^[ \\t]*([A-Za-z_][A-Za-z0-9_-]*)[ \\t]+(?=\\S)",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.lex"
        }
      },
      "patterns": [
        {
          "include": "source.lex-regexp"
        }
      ]
    },
    "directives": {
      "name": "meta.directive.lex",
      "begin": "^[ \\t]*((%)\\w+)(?=[ \\t]|$)",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.directive.lex"
        },
        "2": {
          "name": "punctuation.definition.directive.lex"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\S+",
          "name": "constant.language.other.lex"
        }
      ]
    },
    "passthrough": {
      "name": "meta.code-chunk.lex",
      "begin": "^[ \\t]*%\\{",
      "end": "^[ \\t]*%\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.lex"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.lex"
        }
      },
      "patterns": [
        {
          "include": "source.cpp"
        }
      ]
    },
    "rules": {
      "begin": "^[ \\t]*(%%)[ \\t]*(?=$|/\\*|//)",
      "end": "^[ \\t]*(%%)[ \\t]*(?=$|/\\*|//)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.section.begin.lex"
        }
      },
      "endCaptures": {
        "1": {
          "name": "keyword.control.section.end.lex"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#passthrough"
        },
        {
          "include": "#rule-pattern"
        },
        {
          "include": "#rule-action"
        }
      ]
    },
    "rule-pattern": {
      "name": "meta.pattern.lex",
      "begin": "^(?=[^\\s%]|%(?!\\{|%))",
      "end": "(?=[ \\t]|$)",
      "patterns": [
        {
          "include": "source.lex-regexp"
        }
      ]
    },
    "rule-action": {
      "patterns": [
        {
          "begin": "[ \\t]+(?=\\{)",
          "end": "(?<=\\})",
          "patterns": [
            {
              "include": "#balanced-braces"
            }
          ]
        },
        {
          "begin": "[ \\t]+(?=\\S)",
          "end": "$",
          "patterns": [
            {
              "include": "source.cpp"
            }
          ]
        }
      ]
    },
    "user-code": {
      "name": "meta.user-code.lex",
      "begin": "(?<=%%)",
      "end": "(?=a)b",
      "contentName": "source.embedded.cpp",
      "patterns": [
        {
          "include": "source.cpp"
        }
      ]
    }
  }
}
