{
  "scopeName": "source.yacc",
  "name": "Yacc/Bison",
  "fileTypes": [
    "bison",
    "y",
    "yy",
    "ypp",
    "yacc"
  ],
  "dependencies": [
    "cpp",
    "java"
  ],
  "patterns": [
    {
      "include": "#main"
    }
  ],
  "repository": {
    "main": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#prologue"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#rules"
        },
        {
          "include": "#epilogue"
        },
        {
          "include": "#data-type"
        }
      ]
    },
    "action": {
      "patterns": [
        {
          "name": "meta.predicate.yacc",
          "begin": "(%\\?)(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.predicate.action.yacc"
            },
            "2": {
              "name": "punctuation.section.block.begin.bracket.curly.c"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.bracket.curly.c"
            }
          },
          "patterns": [
            {
              "include": "#action-innards"
            }
          ]
        },
        {
          "name": "meta.action.yacc",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.block.begin.bracket.curly.c"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.bracket.curly.c"
            }
          },
          "patterns": [
            {
              "include": "#action-innards"
            }
          ]
        }
      ]
    },
    "action-innards": {
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.block.begin.bracket.curly.c"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.bracket.curly.c"
            }
          },
          "patterns": [
            {
              "include": "#action-innards"
            }
          ]
        },
        {
          "include": "#action-vars"
        },
        {
          "include": "#bison-defs"
        },
        {
          "include": "source.cpp"
        }
      ]
    },
    "action-vars": {
      "patterns": [
        {
          "name": "constant.language.predefined-symbol.yacc",
          "match": "(\\$)(undefined|accept|end)(?![-.])\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.symbol.yacc"
            }
          }
        },
        {
          "name": "constant.language.predefined-symbol.error.yacc",
          "match": "(?<![-.$])\\b(error)(?![-.])\\b"
        },
        {
          "name": "variable.language.midrule-action-symbol.yacc",
          "match": "(\\$@)([0-9]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.yacc"
            }
          }
        },
        {
          "name": "variable.language.rule-location.lhs.yacc",
          "match": "(@)\\$",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.yacc"
            }
          }
        },
        {
          "name": "variable.language.positional.rule-location.rhs.yacc",
          "match": "(@)([0-9]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.yacc"
            }
          }
        },
        {
          "name": "variable.language.rule-value.lhs.yacc",
          "match": "(\\$)\\$",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.yacc"
            }
          }
        },
        {
          "name": "variable.language.positional.rule-value.rhs.yacc",
          "match": "(\\$)([0-9]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.yacc"
            }
          }
        },
        {
          "name": "variable.language.symbol-location.yacc",
          "match": "(@)[A-Za-z_.][-.\\w]*|(@)(\\[)[ \\t]*[A-Za-z_.][-.\\w]*[ \\t]*(\\])",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.yacc"
            },
            "2": {
              "name": "punctuation.definition.variable.yacc"
            },
            "3": {
              "name": "punctuation.section.begin.bracket.square.yacc"
            },
            "4": {
              "name": "punctuation.section.end.bracket.square.yacc"
            }
          }
        },
        {
          "name": "variable.language.symbol-value.yacc",
          "match": "(\\$)[A-Za-z_.][-.\\w]*|(\\$\\[)[ \\t]*[A-Za-z_.][-.\\w]*[ \\t]*(\\])",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.yacc"
            },
            "2": {
              "name": "punctuation.definition.variable.begin.yacc"
            },
            "3": {
              "name": "punctuation.definition.variable.end.yacc"
            }
          }
        }
      ]
    },
    "balanced-cpp-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#balanced-cpp-braces"
        },
        {
          "include": "source.cpp"
        }
      ]
    },
    "balanced-java-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#balanced-java-braces"
        },
        {
          "include": "source.java"
        }
      ]
    },
    "bison-defs": {
      "patterns": [
        {
          "name": "support.function.yacc",
          "match": "(?<![.-])\\b(?:YYABORT|YYACCEPT|YYBACKUP|YYDEBUG|YYERROR_VERBOSE|YYERROR|YYFPRINTF|YYINITDEPTH|YYMAXDEPTH|YYPRINT|YYRECOVERING|YYSTACK_USE_ALLOCA|yyerrok|yyerror|yylex|yyparse|yypstate_delete|yypstate_new|yypull_parse|yypush_parse)\\b(?![.-])"
        },
        {
          "name": "support.variable.yacc",
          "match": "(?<![.-])\\b(?:yychar|yyclearin|yydebug|yylloc|yylval|yynerrs)\\b(?![.-])"
        },
        {
          "name": "support.type.yacc",
          "match": "(?<![.-])\\b(?:YYSTYPE|YYLTYPE)\\b(?![.-])"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.yacc",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.yacc"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.yacc"
            }
          }
        },
        {
          "name": "comment.line.double-slash.yacc",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.yacc"
            }
          }
        }
      ]
    },
    "constant": {
      "name": "constant.language.other.token.yacc",
      "match": "\\w+"
    },
    "data-type": {
      "patterns": [
        {
          "name": "storage.modifier.type.yacc",
          "match": "(<)(\\*)(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.angle.bracket.begin.yacc"
            },
            "2": {
              "name": "constant.language.default.yacc"
            },
            "3": {
              "name": "punctuation.definition.angle.bracket.end.yacc"
            }
          }
        },
        {
          "name": "storage.modifier.type.yacc",
          "begin": "<",
          "end": ">",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.angle.bracket.begin.yacc"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.angle.bracket.end.yacc"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "begin": "^[ \\t]*((%)union)\\b[ \\t]*(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.union.yacc"
            },
            "2": {
              "name": "punctuation.definition.token.percentage-sign.yacc"
            },
            "3": {
              "name": "punctuation.definition.curly.bracket.begin.yacc"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.curly.bracket.end.yacc"
            }
          },
          "patterns": [
            {
              "include": "#balanced-cpp-braces"
            },
            {
              "include": "source.cpp"
            }
          ]
        },
        {
          "name": "meta.code-block.yacc",
          "begin": "^[ \\t]*((%)code)[ \\t]+(imports)[ \\t]*(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.code.yacc"
            },
            "2": {
              "name": "punctuation.definition.token.percentage-sign.yacc"
            },
            "3": {
              "name": "constant.language.other.qualifier.yacc"
            },
            "4": {
              "name": "punctuation.definition.curly.bracket.begin.yacc"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.curly.bracket.end.yacc"
            }
          },
          "patterns": [
            {
              "include": "#balanced-java-braces"
            },
            {
              "include": "source.java"
            }
          ]
        },
        {
          "name": "meta.code-block.yacc",
          "begin": "^[ \\t]*((%)(?:code|destructor|initial-action|lex-param|parse-param|param|printer))(?:[ \\t]+(\\w+))?[ \\t]*(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.yacc"
            },
            "2": {
              "name": "punctuation.definition.token.percentage-sign.yacc"
            },
            "3": {
              "name": "constant.language.other.qualifier.yacc"
            },
            "4": {
              "name": "punctuation.definition.curly.bracket.begin.yacc"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.curly.bracket.end.yacc"
            }
          },
          "patterns": [
            {
              "include": "#balanced-cpp-braces"
            },
            {
              "include": "source.cpp"
            }
          ]
        },
        {
          "name": "meta.defines.yacc",
          "match": "^[ \\t]*((%)defines)(?=[ \\t]|$|/\\*|//)(?:[ \\t]+(?!//|/\\*)(\\S+))?",
          "captures": {
            "1": {
              "name": "keyword.control.directive.defines.yacc"
            },
            "2": {
              "name": "punctuation.definition.token.percentage-sign.yacc"
            },
            "3": {
              "name": "string.unquoted.filename.yacc"
            }
          }
        },
        {
          "begin": "^[ \\t]*((%)define)(?:[ \\t]+([A-Za-z_.][-.\\w]*))?[ \\t]*(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.define.yacc"
            },
            "2": {
              "name": "punctuation.definition.token.percentage-sign.yacc"
            },
            "3": {
              "name": "entity.name.variable.yacc"
            },
            "4": {
              "name": "punctuation.definition.curly.bracket.begin.yacc"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.curly.bracket.end.yacc"
            }
          },
          "patterns": [
            {
              "include": "#balanced-cpp-braces"
            },
            {
              "include": "source.cpp"
            }
          ]
        },
        {
          "begin": "^[ \\t]*((%)define)(?:[ \\t]+([A-Za-z_.][-.\\w]*))?",
          "end": "$|^(?=[ \\t]*%%)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.define.yacc"
            },
            "2": {
              "name": "punctuation.definition.token.percentage-sign.yacc"
            },
            "3": {
              "name": "entity.name.variable.yacc"
            }
          },
          "patterns": [
            {
              "include": "#declaration-innards"
            }
          ]
        },
        {
          "begin": "^[ \\t]*((%)option)(?=[ \\t]|$)",
          "end": "$|(?=[ \\t]*(?://|/\\*))",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.option.yacc"
            },
            "2": {
              "name": "punctuation.definition.token.percentage-sign.yacc"
            }
          },
          "patterns": [
            {
              "name": "constant.language.option-name.yacc",
              "match": "[A-Za-z_.][-.\\w]*"
            },
            {
              "include": "#declaration-innards"
            }
          ]
        },
        {
          "begin": "^[ \\t]*((%)(?:code|debug|destructor|dprec|empty|error-verbose|expect-rr|expect|file-prefix|glr-parser|initial-action|language|left|lex-param|locations|merge|name-prefix|no-lines|nonassoc|nterm|output|param|parse-param|precedence|prec|printer|pure-parser|required?|right|skeleton|start|token-table|token|type|union|verbose|yacc))\\b",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.yacc"
            },
            "2": {
              "name": "punctuation.definition.token.percentage-sign.yacc"
            }
          },
          "patterns": [
            {
              "include": "#declaration-innards"
            }
          ]
        }
      ]
    },
    "declaration-innards": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#data-type"
        },
        {
          "include": "#constant"
        }
      ]
    },
    "epilogue": {
      "name": "meta.epilogue.yacc",
      "begin": "(?<=%%)",
      "end": "(?=a)b",
      "patterns": [
        {
          "include": "source.cpp"
        }
      ]
    },
    "prologue": {
      "name": "meta.prologue.yacc",
      "begin": "^[ \\t]*(%\\{)",
      "end": "^[ \\t]*(%\\})",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.yacc"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.end.yacc"
        }
      },
      "patterns": [
        {
          "include": "#declarations"
        },
        {
          "include": "source.cpp"
        }
      ]
    },
    "rules": {
      "name": "meta.rules.yacc",
      "begin": "^[ \\t]*(%%)",
      "end": "^[ \\t]*(%%)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.section.begin.yacc"
        }
      },
      "endCaptures": {
        "1": {
          "name": "keyword.control.section.end.yacc"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#rule"
        }
      ]
    },
    "rule": {
      "name": "meta.rule.yacc",
      "begin": "^[ \\t]*([A-Za-z_.][-.\\w]*)[ \\t]*(:)",
      "end": ";",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.yacc"
        },
        "2": {
          "name": "punctuation.separator.key-value.colon.yacc"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.statement.semicolon.yacc"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#action"
        },
        {
          "match": "%(?:prec|dprec|merge|empty)\\b",
          "name": "keyword.control.directive.yacc"
        },
        {
          "match": "\\|",
          "name": "keyword.operator.logical.or.yacc"
        },
        {
          "match": "[A-Za-z_.][-.\\w]*",
          "name": "variable.reference.yacc"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.yacc",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.yacc"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.yacc"
            }
          },
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.yacc"
            }
          ]
        },
        {
          "name": "string.quoted.single.yacc",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.yacc"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.yacc"
            }
          },
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.yacc"
            }
          ]
        }
      ]
    }
  }
}
