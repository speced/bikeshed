{
  "dependencies": [
    "css"
  ],
  "patterns": [
    {
      "match": "//.*$",
      "name": "comment.line.double-slash"
    },
    {
      "match": "\\$[a-zA-Z_-][\\w-]*",
      "name": "entity.name.variable"
    },
    {
      "match": "#\\{[^}]+\\}",
      "name": "entity.name.interpolation"
    },
    {
      "match": "(?:&|%[a-zA-Z_-][\\w-]*)",
      "name": "entity.name.selector"
    },
    {
      "captures": {
        "1": {
          "name": "keyword.control"
        },
        "2": {
          "name": "entity.name.function"
        }
      },
      "match": "@(mixin|include|function)\\s+([a-zA-Z_-][\\w-]*)"
    },
    {
      "captures": {
        "1": {
          "name": "keyword.control"
        }
      },
      "match": "@(if|else|each|for|while|return|use|forward|extend|at-root|debug|warn|error)\\b"
    },
    {
      "match": "(?:==|!=|<=|>=|[+*/%-])",
      "name": "keyword.operator"
    },
    {
      "include": "source.css"
    }
  ],
  "scopeName": "source.scss"
}
