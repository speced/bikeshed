{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#class-declaration"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "attributes": {
      "match": "@[A-Za-z_][\\w]*",
      "name": "entity.name.decorator"
    },
    "builtin-types": {
      "match": "\\b(?:Any|AnyObject|Array|Bool|Character|Dictionary|Double|Float|Int|Int8|Int16|Int32|Int64|Optional|Set|String|UInt|UInt8|UInt16|UInt32|UInt64|Void)\\b",
      "name": "support.class.builtin"
    },
    "class-declaration": {
      "captures": {
        "1": {
          "name": "storage.type.class"
        },
        "2": {
          "name": "entity.name.type.class"
        }
      },
      "match": "\\b(class|struct|enum|protocol|extension)\\s+([A-Za-z_]\\w*)"
    },
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:true|false)\\b",
          "name": "constant.language.boolean"
        },
        {
          "match": "\\bnil\\b",
          "name": "constant.language"
        }
      ]
    },
    "function-declaration": {
      "captures": {
        "1": {
          "name": "storage.type.function"
        },
        "2": {
          "name": "entity.name.function"
        }
      },
      "match": "\\b(func)\\s+([A-Za-z_]\\w*)"
    },
    "keywords": {
      "match": "\\b(?:as|associatedtype|break|case|catch|continue|convenience|default|defer|deinit|do|else|fallthrough|fileprivate|final|for|guard|if|import|in|indirect|inout|internal|is|lazy|let|mutating|open|override|private|public|repeat|required|rethrows|return|self|Self|some|static|subscript|super|switch|throw|throws|try|unowned|var|weak|where|while)\\b",
      "name": "keyword.control"
    },
    "numbers": {
      "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "(?:->|\\?\\?|\\.\\.[.<]|&&|\\|\\||==|!=|<=|>=|[+\\-*/%!<>=?]=?)",
      "name": "keyword.operator"
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple"
        },
        {
          "match": "\"(?:\\\\.|[^\"\\\\\\r\\n])*\"",
          "name": "string.quoted.double"
        }
      ]
    }
  },
  "scopeName": "source.swift"
}
