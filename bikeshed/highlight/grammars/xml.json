{
  "scopeName": "text.xml",
  "name": "xml",
  "fileTypes": [
    "xml",
    "xsd",
    "xsl",
    "xslt",
    "xhtml"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#cdata"
    },
    {
      "include": "#processing-instruction"
    },
    {
      "include": "#doctype"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#entities"
    }
  ],
  "repository": {
    "attributes": {
      "begin": "\\s+(?:([a-zA-Z_][\\w.-]*)(:))?([a-zA-Z_][\\w.-]*)\\s*=\\s*(['\"])",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name"
        },
        "2": {
          "name": "punctuation.separator.namespace.xml"
        },
        "3": {
          "name": "entity.other.attribute-name"
        },
        "4": {
          "name": "punctuation.definition.string.begin.xml"
        }
      },
      "contentName": "string.quoted.attribute-value.xml",
      "end": "\\4",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.xml"
        }
      },
      "patterns": [
        {
          "include": "#entities"
        }
      ]
    },
    "cdata": {
      "begin": "<!\\[CDATA\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.xml"
        }
      },
      "contentName": "string.unquoted.cdata.xml",
      "end": "\\]\\]>",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.xml"
        }
      }
    },
    "comments": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block.xml"
    },
    "doctype": {
      "begin": "<!DOCTYPE\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.doctype"
        }
      },
      "end": ">",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#internal-subset"
        },
        {
          "match": "\\b(?:PUBLIC|SYSTEM)\\b",
          "name": "keyword.other.xml"
        },
        {
          "include": "#strings"
        }
      ]
    },
    "dtd-declarations": {
      "begin": "<!(?:ELEMENT|ATTLIST|ENTITY|NOTATION)\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.doctype"
        }
      },
      "end": ">",
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#parameter-entities"
        },
        {
          "match": "#(?:PCDATA|REQUIRED|IMPLIED|FIXED)\\b|\\b(?:EMPTY|ANY|CDATA|ID|IDREF|IDREFS|ENTITY|ENTITIES|NMTOKEN|NMTOKENS|NDATA|PUBLIC|SYSTEM)\\b",
          "name": "keyword.other.xml"
        }
      ]
    },
    "entities": {
      "match": "&(?:#\\d+|#x[0-9a-fA-F]+|[a-zA-Z_:][\\w:.-]*);",
      "name": "constant.character.entity.xml"
    },
    "internal-subset": {
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#dtd-declarations"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#parameter-entities"
        }
      ]
    },
    "parameter-entities": {
      "match": "%[a-zA-Z_:][\\w:.-]*;",
      "name": "constant.character.entity.xml"
    },
    "processing-instruction": {
      "begin": "<\\?([a-zA-Z_:][\\w:.-]*)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.xml"
        }
      },
      "end": "\\?>",
      "patterns": [
        {
          "include": "#attributes"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "match": "\"[^\"]*\"",
          "name": "string.quoted.double.xml"
        },
        {
          "match": "'[^']*'",
          "name": "string.quoted.single.xml"
        }
      ]
    },
    "tags": {
      "begin": "</?(?:([a-zA-Z_][\\w.-]*)(:))?([a-zA-Z_][\\w.-]*)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.namespace.xml"
        },
        "2": {
          "name": "punctuation.separator.namespace.xml"
        },
        "3": {
          "name": "entity.name.tag.localname.xml"
        }
      },
      "end": "/?>",
      "patterns": [
        {
          "include": "#attributes"
        }
      ]
    }
  }
}
