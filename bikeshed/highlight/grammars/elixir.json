{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#heredocs"
    },
    {
      "include": "#sigils"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#atoms"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#module-declaration"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#modules"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function-call"
    }
  ],
  "repository": {
    "atoms": {
      "patterns": [
        {
          "match": ":(?:[a-zA-Z_][\\w@]*[!?]?|[-+*/<>=|&~^.%]+)",
          "name": "constant.other.symbol"
        },
        {
          "match": ":(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*')",
          "name": "constant.other.symbol"
        }
      ]
    },
    "attributes": {
      "match": "@[a-zA-Z_][\\w]*",
      "name": "entity.name.variable"
    },
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign"
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:true|false)\\b",
          "name": "constant.language.boolean"
        },
        {
          "match": "\\bnil\\b",
          "name": "constant.language"
        }
      ]
    },
    "function-call": {
      "match": "\\b[a-zA-Z_][\\w]*[!?]?(?=\\s*(?:\\(|[\"']))",
      "name": "entity.name.function"
    },
    "function-declaration": {
      "captures": {
        "1": {
          "name": "storage.type.function"
        },
        "2": {
          "name": "entity.name.function"
        }
      },
      "match": "\\b(def|defp|defmacro|defmacrop|defguard|defguardp|defdelegate)\\s+([a-zA-Z_][\\w]*[!?]?)"
    },
    "heredocs": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple.double"
        },
        {
          "begin": "'''",
          "end": "'''",
          "name": "string.quoted.triple.single"
        }
      ]
    },
    "keywords": {
      "match": "\\b(?:after|alias|and|case|catch|cond|defstruct|do|else|end|fn|for|if|import|in|not|or|quote|raise|receive|require|rescue|reraise|super|throw|try|unless|unquote|unquote_splicing|use|when|with)\\b",
      "name": "keyword.control"
    },
    "module-declaration": {
      "captures": {
        "1": {
          "name": "storage.type.module"
        },
        "2": {
          "name": "entity.name.type.module"
        }
      },
      "match": "\\b(defmodule|defprotocol|defimpl)\\s+([A-Z][\\w]*(?:\\.[A-Z][\\w]*)*)"
    },
    "modules": {
      "match": "\\b[A-Z][\\w]*(?:\\.[A-Z][\\w]*)*\\b",
      "name": "entity.name.type.module"
    },
    "numbers": {
      "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "(?:===|!==|==|!=|<=|>=|=>|<-|->|\\+\\+|--|<>|&&|\\|\\||\\|>|=~|\\^\\^\\^|~~~|::|\\.\\.|[+\\-*/<>=|&!^~])",
      "name": "keyword.operator"
    },
    "sigils": {
      "patterns": [
        {
          "match": "~[a-zA-Z]/(?:\\\\.|[^/\\\\])*/[a-zA-Z]*",
          "name": "string.regexp"
        },
        {
          "match": "~[a-zA-Z]\\|(?:\\\\.|[^|\\\\])*\\|[a-zA-Z]*",
          "name": "string.regexp"
        },
        {
          "match": "~[a-zA-Z]\\{(?:\\\\.|[^}\\\\])*\\}[a-zA-Z]*",
          "name": "string.regexp"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "match": "\"(?:\\\\.|[^\"\\\\])*\"",
          "name": "string.quoted.double"
        },
        {
          "match": "'(?:\\\\.|[^'\\\\])*'",
          "name": "string.quoted.single"
        }
      ]
    }
  },
  "scopeName": "source.elixir"
}
