{
  "scopeName": "source.http",
  "name": "http",
  "fileTypes": [
    "http",
    "rest"
  ],
  "dependencies": [
    "bash",
    "graphql",
    "html",
    "json"
  ],
  "patterns": [
    {
      "begin": "^[ \\t]*(?=curl\\b)",
      "name": "http.request.curl",
      "end": "^[ \\t]*(#{3,}.*?)?[ \\t]*$",
      "endCaptures": {
        "1": {
          "name": "comment.line.sharp.http"
        }
      },
      "patterns": [
        {
          "include": "source.shell"
        }
      ]
    },
    {
      "begin": "^[ \\t]*(?=\\[|\\{[^{])",
      "name": "http.request.body.json",
      "end": "^[ \\t]*(#{3,}.*?)?[ \\t]*$",
      "endCaptures": {
        "1": {
          "name": "comment.line.sharp.http"
        }
      },
      "patterns": [
        {
          "include": "source.json"
        }
      ]
    },
    {
      "begin": "^[ \\t]*(?=<\\S)",
      "name": "http.request.body.xml",
      "end": "^[ \\t]*(#{3,}.*?)?[ \\t]*$",
      "endCaptures": {
        "1": {
          "name": "comment.line.sharp.http"
        }
      },
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    },
    {
      "begin": "^[ \\t]*(?=(?:query|mutation)(?:[ \\t]+\\w+)?[ \\t]*[({])",
      "name": "http.request.body.graphql",
      "end": "^[ \\t]*(#{3,}.*?)?[ \\t]*$|^(?=\\{[ \\t]*$)",
      "endCaptures": {
        "1": {
          "name": "comment.line.sharp.http"
        }
      },
      "patterns": [
        {
          "include": "source.graphql"
        }
      ]
    },
    {
      "include": "#metadata"
    },
    {
      "include": "#comments"
    },
    {
      "captures": {
        "1": {
          "name": "keyword.other.http"
        },
        "2": {
          "name": "variable.other.http"
        },
        "3": {
          "name": "string.other.http"
        }
      },
      "match": "^[ \\t]*(@)([^\\s=]+)[ \\t]*=[ \\t]*(.*?)[ \\t]*$",
      "name": "http.filevariable"
    },
    {
      "captures": {
        "1": {
          "name": "keyword.operator.http"
        },
        "2": {
          "name": "variable.other.http"
        },
        "3": {
          "name": "string.other.http"
        }
      },
      "match": "^[ \\t]*(\\?|&)([^=\\s]+)=(.*)$",
      "name": "http.query"
    },
    {
      "captures": {
        "1": {
          "name": "entity.name.tag.http"
        },
        "2": {
          "name": "keyword.other.http"
        },
        "3": {
          "name": "string.other.http"
        }
      },
      "match": "^[ \\t]*(:?[\\w-]+)[ \\t]*(:)(?!//)[ \\t]*(.*?)[ \\t]*$",
      "name": "http.headers"
    },
    {
      "include": "#request-line"
    },
    {
      "include": "#response-line"
    }
  ],
  "repository": {
    "metadata": {
      "patterns": [
        {
          "match": "^[ \\t]*#{1,}[ \\t]+(?:((@)name)[ \\t]+([^\\s.]+))$",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name"
            },
            "2": {
              "name": "punctuation.definition.block.tag.metadata"
            },
            "3": {
              "name": "entity.name.type.http"
            }
          },
          "name": "comment.line.sharp.http"
        },
        {
          "match": "^[ \\t]*/{2,}[ \\t]+(?:((@)name)[ \\t]+([^\\s.]+))$",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name"
            },
            "2": {
              "name": "punctuation.definition.block.tag.metadata"
            },
            "3": {
              "name": "entity.name.type.http"
            }
          },
          "name": "comment.line.double-slash.http"
        },
        {
          "match": "^[ \\t]*#{1,}[ \\t]+((@)note)[ \\t]*$",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name"
            },
            "2": {
              "name": "punctuation.definition.block.tag.metadata"
            }
          },
          "name": "comment.line.sharp.http"
        },
        {
          "match": "^[ \\t]*/{2,}[ \\t]+((@)note)[ \\t]*$",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name"
            },
            "2": {
              "name": "punctuation.definition.block.tag.metadata"
            }
          },
          "name": "comment.line.double-slash.http"
        },
        {
          "match": "^[ \\t]*#{1,}[ \\t]+(?:((@)prompt)[ \\t]+([^\\s]+)(?:[ \\t]+(.*?))?[ \\t]*)$",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name"
            },
            "2": {
              "name": "punctuation.definition.block.tag.metadata"
            },
            "3": {
              "name": "variable.other.http"
            },
            "4": {
              "name": "string.other.http"
            }
          },
          "name": "comment.line.sharp.http"
        },
        {
          "match": "^[ \\t]*/{2,}[ \\t]+(?:((@)prompt)[ \\t]+([^\\s]+)(?:[ \\t]+(.*?))?[ \\t]*)$",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name"
            },
            "2": {
              "name": "punctuation.definition.block.tag.metadata"
            },
            "3": {
              "name": "variable.other.http"
            },
            "4": {
              "name": "string.other.http"
            }
          },
          "name": "comment.line.double-slash.http"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "^[ \\t]*#{1,}.*$",
          "name": "comment.line.sharp.http"
        },
        {
          "match": "^[ \\t]*/{2,}.*$",
          "name": "comment.line.double-slash.http"
        }
      ]
    },
    "request-line": {
      "captures": {
        "1": {
          "name": "keyword.control.http"
        },
        "2": {
          "name": "constant.language.http"
        },
        "3": {
          "name": "keyword.other.http"
        },
        "4": {
          "name": "constant.numeric.http"
        }
      },
      "match": "^[ \\t]*(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|CONNECT|TRACE|LOCK|UNLOCK|PROPFIND|PROPPATCH|COPY|MOVE|MKCOL|MKCALENDAR|ACL|SEARCH|get|post|put|delete|patch|head|options|connect|trace|lock|unlock|propfind|proppatch|copy|move|mkcol|mkcalendar|acl|search)[ \\t]+(.+?)(?:[ \\t]+([Hh][Tt][Tt][Pp])/(\\d+(?:\\.\\d+)?))?[ \\t]*$",
      "name": "http.requestline"
    },
    "response-line": {
      "captures": {
        "1": {
          "name": "keyword.other.http"
        },
        "2": {
          "name": "constant.numeric.http"
        },
        "3": {
          "name": "constant.numeric.http"
        },
        "4": {
          "name": "string.other.http"
        }
      },
      "match": "^[ \\t]*([Hh][Tt][Tt][Pp])/(\\d+(?:\\.\\d+)?)[ \\t]+([1-5][0-9][0-9])(?:[ \\t]+(.*?))?[ \\t]*$",
      "name": "http.responseLine"
    }
  }
}
