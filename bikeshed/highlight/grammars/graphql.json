{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#type-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#field-arguments"
    },
    {
      "include": "#field-name"
    }
  ],
  "repository": {
    "builtin-types": {
      "match": "\\b(?:Int|Float|String|Boolean|ID)\\b",
      "name": "support.class.builtin"
    },
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign"
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:true|false)\\b",
          "name": "constant.language.boolean"
        },
        {
          "match": "\\bnull\\b",
          "name": "constant.language"
        }
      ]
    },
    "directives": {
      "match": "@[A-Za-z_][\\w]*",
      "name": "entity.name.decorator"
    },
    "field-arguments": {
      "match": "\\b([A-Za-z_][\\w]*)(?=\\s*:)",
      "name": "entity.name.property"
    },
    "field-name": {
      "match": "\\b([A-Za-z_][\\w]*)(?=\\s*\\()",
      "name": "entity.name.function"
    },
    "keywords": {
      "match": "\\b(?:implements|on|repeatable|query|mutation|subscription)\\b",
      "name": "keyword.control"
    },
    "numbers": {
      "match": "(?<![\\w.])-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b",
      "name": "constant.numeric"
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple"
        },
        {
          "match": "\"(?:\\\\.|[^\"\\\\\\r\\n])*\"",
          "name": "string.quoted.double"
        }
      ]
    },
    "type-declaration": {
      "captures": {
        "1": {
          "name": "storage.type"
        },
        "2": {
          "name": "entity.name.type.class"
        }
      },
      "match": "\\b(type|interface|input|enum|union|scalar|schema|directive|extend|fragment)\\s+([A-Za-z_][\\w]*)?"
    },
    "variables": {
      "match": "\\$[A-Za-z_][\\w]*",
      "name": "entity.name.variable"
    }
  },
  "scopeName": "source.graphql"
}
