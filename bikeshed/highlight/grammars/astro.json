{
  "dependencies": [
    "html",
    "css",
    "scss",
    "javascript",
    "typescript",
    "tsx"
  ],
  "patterns": [
    {
      "include": "#frontmatter"
    },
    {
      "include": "#script"
    },
    {
      "include": "#style"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "frontmatter": {
      "begin": "^---\\s*$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.frontmatter.begin.astro"
        }
      },
      "contentName": "meta.embedded.block.astro",
      "end": "^---\\s*$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.frontmatter.end.astro"
        }
      },
      "patterns": [
        {
          "include": "source.ts"
        }
      ]
    },
    "interpolation": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.astro"
        }
      },
      "contentName": "meta.embedded.expression.astro",
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.astro"
        }
      },
      "patterns": [
        {
          "include": "text.html.basic#comments"
        },
        {
          "include": "source.tsx"
        }
      ]
    },
    "script": {
      "patterns": [
        {
          "begin": "<(script)\\s*>",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag"
            }
          },
          "contentName": "source.ts.embedded.astro",
          "end": "</(script)\\s*>",
          "endCaptures": {
            "1": {
              "name": "entity.name.tag"
            }
          },
          "patterns": [
            {
              "include": "source.ts"
            }
          ]
        },
        {
          "include": "text.html.basic#embedded-javascript"
        }
      ]
    },
    "style": {
      "patterns": [
        {
          "begin": "<(style)\\b(?=[^>]*\\blang\\s*=\\s*(['\"])scss\\2)[^>]*>",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag"
            }
          },
          "contentName": "source.scss.embedded.astro",
          "end": "</(style)\\s*>",
          "endCaptures": {
            "1": {
              "name": "entity.name.tag"
            }
          },
          "patterns": [
            {
              "include": "source.scss"
            }
          ]
        },
        {
          "include": "source.css"
        }
      ]
    }
  },
  "scopeName": "source.astro"
}
