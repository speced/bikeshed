{
  "dependencies": [
    "yaml"
  ],
  "patterns": [
    {
      "include": "#front-matter"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#fenced-code"
    },
    {
      "include": "#headings"
    },
    {
      "include": "#quotes"
    },
    {
      "include": "#lists"
    },
    {
      "include": "#links"
    },
    {
      "include": "#inline-code"
    }
  ],
  "repository": {
    "comments": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block.html"
    },
    "fenced-code": {
      "begin": "^[ \\t]*(```+|~~~+).*$",
      "end": "^[ \\t]*\\1[ \\t]*$",
      "name": "string.unquoted.fenced-code"
    },
    "front-matter": {
      "begin": "^[ \\t]*---[ \\t]*$",
      "end": "^[ \\t]*(?:---|\\.\\.\\.)[ \\t]*$",
      "patterns": [
        {
          "include": "source.yaml"
        }
      ]
    },
    "headings": {
      "captures": {
        "1": {
          "name": "entity.name.section"
        }
      },
      "match": "^[ \\t]{0,3}#{1,6}[ \\t]+(.+)$"
    },
    "inline-code": {
      "captures": {
        "2": {
          "name": "string.other.raw"
        }
      },
      "match": "(`+)(.+?)\\1"
    },
    "links": {
      "captures": {
        "1": {
          "name": "entity.name.link"
        },
        "2": {
          "name": "string.other.link"
        }
      },
      "match": "!?\\[([^\\]]+)\\](\\([^\\s)]+(?:\\s+['\"][^'\"]*['\"])?\\))"
    },
    "lists": {
      "match": "^[ \\t]*(?:[-+*]|\\d+[.)])(?=[ \\t]+)",
      "name": "keyword.control.list"
    },
    "quotes": {
      "match": "^[ \\t]*>.*$",
      "name": "comment.blockquote"
    }
  },
  "scopeName": "text.html.markdown"
}
