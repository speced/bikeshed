{
  "name": "kdl",
  "scopeName": "source.kdl",
  "fileTypes": [
    "kdl"
  ],
  "patterns": [
    {
      "include": "#nodes"
    }
  ],
  "repository": {
    "nodes": {
      "patterns": [
        {
          "include": "#kdl-version"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#slashdash-node"
        },
        {
          "include": "#escline"
        },
        {
          "include": "#type-annotation"
        },
        {
          "include": "#node"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.node.kdl"
        }
      ]
    },
    "kdl-version": {
      "match": "^([ \\t]*)(/-[ \\t]*kdl-version)[ \\t]+([0-9]+(?:\\.[0-9]+)*)\\b",
      "captures": {
        "2": {
          "name": "keyword.other.directive.kdl"
        },
        "3": {
          "name": "constant.numeric.version.kdl"
        }
      }
    },
    "comments": {
      "patterns": [
        {
          "include": "#line-comment"
        },
        {
          "include": "#block-comment"
        }
      ]
    },
    "line-comment": {
      "match": "//[^\\r\\n]*",
      "name": "comment.line.double-slash.kdl"
    },
    "block-comment": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.kdl",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "escline": {
      "match": "(\\\\)((?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*)((?://[^\\r\\n]*)?)\\r?\\n",
      "captures": {
        "1": {
          "name": "constant.character.escape.line-continuation.kdl"
        },
        "2": {
          "patterns": [
            {
              "include": "#block-comment"
            }
          ]
        },
        "3": {
          "name": "comment.line.double-slash.kdl"
        }
      }
    },
    "slashdash-node": {
      "begin": "/-(?:[ \\t\\r\\n]+|//[^\\r\\n]*|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*",
      "end": ";|(?=\\r?\\n|\\}|//)",
      "name": "comment.block.slashdash.kdl",
      "patterns": [
        {
          "include": "#slashdash-contents"
        }
      ]
    },
    "slashdash-block": {
      "begin": "/-(?:[ \\t\\r\\n]+|//[^\\r\\n]*|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*\\{",
      "end": "\\}",
      "name": "comment.block.slashdash.kdl",
      "patterns": [
        {
          "include": "#slashdash-block-contents"
        }
      ]
    },
    "slashdash-contents": {
      "patterns": [
        {
          "match": "\\\\(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*(?://[^\\r\\n]*)?\\r?\\n"
        },
        {
          "include": "#block-comment"
        },
        {
          "begin": "(#+)(\"\"\"|\")",
          "end": "\\2\\1"
        },
        {
          "begin": "\"\"\"(?=\\r?\\n)",
          "end": "\"\"\"",
          "patterns": [
            {
              "match": "\\\\."
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"|(?=\\r?\\n)",
          "patterns": [
            {
              "match": "\\\\(?:[\\s]+|.)"
            }
          ]
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#slashdash-block-contents"
            }
          ]
        }
      ]
    },
    "slashdash-block-contents": {
      "patterns": [
        {
          "include": "#line-comment"
        },
        {
          "include": "#block-comment"
        },
        {
          "begin": "(#+)(\"\"\"|\")",
          "end": "\\2\\1"
        },
        {
          "begin": "\"\"\"(?=\\r?\\n)",
          "end": "\"\"\"",
          "patterns": [
            {
              "match": "\\\\."
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"|(?=\\r?\\n)",
          "patterns": [
            {
              "match": "\\\\(?:[\\s]+|.)"
            }
          ]
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#slashdash-block-contents"
            }
          ]
        }
      ]
    },
    "slashdash-entry": {
      "patterns": [
        {
          "begin": "/-(?:[ \\t\\r\\n]+|//[^\\r\\n]*|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*(?:(?:#+?\"(?:[^\"\\r\\n]|\"(?!#))*\"#+|\"(?:\\\\.|[^\"\\\\\\r\\n])*\"|(?!(?:true|false|null|nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[^\\s\\\\/(){};\\[\\]\"#=0-9+\\-.][^\\s\\\\/(){};\\[\\]\"#=]*|[+-]?\\.(?:[^\\s\\\\/(){};\\[\\]\"#=0-9][^\\s\\\\/(){};\\[\\]\"#=]*)?|[+-](?:[^\\s\\\\/(){};\\[\\]\"#=0-9.][^\\s\\\\/(){};\\[\\]\"#=]*)?)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*=(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*)?(?:\\([ \\t]*(?:#+?\"(?:[^\"\\r\\n]|\"(?!#))*\"#+|\"(?:\\\\.|[^\"\\\\\\r\\n])*\"|(?!(?:true|false|null|nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[^\\s\\\\/(){};\\[\\]\"#=0-9+\\-.][^\\s\\\\/(){};\\[\\]\"#=]*|[+-]?\\.(?:[^\\s\\\\/(){};\\[\\]\"#=0-9][^\\s\\\\/(){};\\[\\]\"#=]*)?|[+-](?:[^\\s\\\\/(){};\\[\\]\"#=0-9.][^\\s\\\\/(){};\\[\\]\"#=]*)?)(?![^\\s\\\\/(){};\\[\\]\"#=]))[ \\t]*\\)(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*)?(#+)(\\\"\\\"\\\")(?=\\r?\\n)",
          "end": "\\2\\1",
          "name": "comment.block.slashdash.kdl"
        },
        {
          "begin": "/-(?:[ \\t\\r\\n]+|//[^\\r\\n]*|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*(?:(?:#+?\"(?:[^\"\\r\\n]|\"(?!#))*\"#+|\"(?:\\\\.|[^\"\\\\\\r\\n])*\"|(?!(?:true|false|null|nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[^\\s\\\\/(){};\\[\\]\"#=0-9+\\-.][^\\s\\\\/(){};\\[\\]\"#=]*|[+-]?\\.(?:[^\\s\\\\/(){};\\[\\]\"#=0-9][^\\s\\\\/(){};\\[\\]\"#=]*)?|[+-](?:[^\\s\\\\/(){};\\[\\]\"#=0-9.][^\\s\\\\/(){};\\[\\]\"#=]*)?)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*=(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*)?(?:\\([ \\t]*(?:#+?\"(?:[^\"\\r\\n]|\"(?!#))*\"#+|\"(?:\\\\.|[^\"\\\\\\r\\n])*\"|(?!(?:true|false|null|nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[^\\s\\\\/(){};\\[\\]\"#=0-9+\\-.][^\\s\\\\/(){};\\[\\]\"#=]*|[+-]?\\.(?:[^\\s\\\\/(){};\\[\\]\"#=0-9][^\\s\\\\/(){};\\[\\]\"#=]*)?|[+-](?:[^\\s\\\\/(){};\\[\\]\"#=0-9.][^\\s\\\\/(){};\\[\\]\"#=]*)?)(?![^\\s\\\\/(){};\\[\\]\"#=]))[ \\t]*\\)(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*)?\\\"\\\"\\\"(?=\\r?\\n)",
          "end": "\"\"\"",
          "name": "comment.block.slashdash.kdl",
          "patterns": [
            {
              "match": "\\\\."
            }
          ]
        },
        {
          "match": "/-(?:[ \\t\\r\\n]+|//[^\\r\\n]*|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*(?:(?:#+?\"(?:[^\"\\r\\n]|\"(?!#))*\"#+|\"(?:\\\\.|[^\"\\\\\\r\\n])*\"|(?!(?:true|false|null|nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[^\\s\\\\/(){};\\[\\]\"#=0-9+\\-.][^\\s\\\\/(){};\\[\\]\"#=]*|[+-]?\\.(?:[^\\s\\\\/(){};\\[\\]\"#=0-9][^\\s\\\\/(){};\\[\\]\"#=]*)?|[+-](?:[^\\s\\\\/(){};\\[\\]\"#=0-9.][^\\s\\\\/(){};\\[\\]\"#=]*)?)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*=(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*)?(?:\\([ \\t]*(?:#+?\"(?:[^\"\\r\\n]|\"(?!#))*\"#+|\"(?:\\\\.|[^\"\\\\\\r\\n])*\"|(?!(?:true|false|null|nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[^\\s\\\\/(){};\\[\\]\"#=0-9+\\-.][^\\s\\\\/(){};\\[\\]\"#=]*|[+-]?\\.(?:[^\\s\\\\/(){};\\[\\]\"#=0-9][^\\s\\\\/(){};\\[\\]\"#=]*)?|[+-](?:[^\\s\\\\/(){};\\[\\]\"#=0-9.][^\\s\\\\/(){};\\[\\]\"#=]*)?)(?![^\\s\\\\/(){};\\[\\]\"#=]))[ \\t]*\\)(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*)?(?:#+?\"(?:[^\"\\r\\n]|\"(?!#))*\"#+|\"(?:\\\\.|[^\"\\\\\\r\\n])*\"|#(?:true|false|null|nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=])|[+-]?(?:0x[0-9A-Fa-f][0-9A-Fa-f_]*|0o[0-7][0-7_]*|0b[01][01_]*|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9][0-9_]*)?)(?![^\\s\\\\/(){};\\[\\]\"#=])|(?!(?:true|false|null|nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[^\\s\\\\/(){};\\[\\]\"#=0-9+\\-.][^\\s\\\\/(){};\\[\\]\"#=]*|[+-]?\\.(?:[^\\s\\\\/(){};\\[\\]\"#=0-9][^\\s\\\\/(){};\\[\\]\"#=]*)?|[+-](?:[^\\s\\\\/(){};\\[\\]\"#=0-9.][^\\s\\\\/(){};\\[\\]\"#=]*)?)(?![^\\s\\\\/(){};\\[\\]\"#=]))",
          "name": "comment.block.slashdash.kdl"
        },
        {
          "match": "/-",
          "name": "comment.block.slashdash.kdl"
        }
      ]
    },
    "node": {
      "patterns": [
        {
          "begin": "((#+)\"(?:(?!\"\\2)[^\\r\\n])*\"\\2)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag.kdl"
            }
          },
          "end": "(;)|(?=\\r?\\n|\\}|//)",
          "endCaptures": {
            "1": {
              "name": "punctuation.terminator.node.kdl"
            }
          },
          "patterns": [
            {
              "include": "#node-body"
            }
          ]
        },
        {
          "begin": "(\"(?:\\\\.|[^\"\\\\\\r\\n])*\")",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag.kdl"
            }
          },
          "end": "(;)|(?=\\r?\\n|\\}|//)",
          "endCaptures": {
            "1": {
              "name": "punctuation.terminator.node.kdl"
            }
          },
          "patterns": [
            {
              "include": "#node-body"
            }
          ]
        },
        {
          "begin": "((?<![^\\s\\\\/(){};\\[\\]\"#=])(?!(?:true|false|null|nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[^\\s\\\\/(){};\\[\\]\"#=0-9+\\-.][^\\s\\\\/(){};\\[\\]\"#=]*|[+-]?\\.(?:[^\\s\\\\/(){};\\[\\]\"#=0-9][^\\s\\\\/(){};\\[\\]\"#=]*)?|[+-](?:[^\\s\\\\/(){};\\[\\]\"#=0-9.][^\\s\\\\/(){};\\[\\]\"#=]*)?)(?![^\\s\\\\/(){};\\[\\]\"#=]))",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag.kdl"
            }
          },
          "end": "(;)|(?=\\r?\\n|\\}|//)",
          "endCaptures": {
            "1": {
              "name": "punctuation.terminator.node.kdl"
            }
          },
          "patterns": [
            {
              "include": "#node-body"
            }
          ]
        }
      ]
    },
    "node-body": {
      "patterns": [
        {
          "include": "#escline"
        },
        {
          "include": "#block-comment"
        },
        {
          "include": "#slashdash-block"
        },
        {
          "include": "#slashdash-entry"
        },
        {
          "include": "#children-block"
        },
        {
          "include": "#property"
        },
        {
          "include": "#type-annotation"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#ident-string"
        }
      ]
    },
    "children-block": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.kdl"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.kdl"
        }
      },
      "patterns": [
        {
          "include": "#nodes"
        }
      ]
    },
    "property": {
      "patterns": [
        {
          "match": "((#+)\"(?:(?!\"\\2)[^\\r\\n])*\"\\2)(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.kdl"
            },
            "3": {
              "name": "keyword.operator.assignment.kdl"
            }
          }
        },
        {
          "match": "(\"(?:\\\\.|[^\"\\\\\\r\\n])*\")(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.kdl"
            },
            "2": {
              "name": "keyword.operator.assignment.kdl"
            }
          }
        },
        {
          "match": "((?<![^\\s\\\\/(){};\\[\\]\"#=])(?!(?:true|false|null|nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[^\\s\\\\/(){};\\[\\]\"#=0-9+\\-.][^\\s\\\\/(){};\\[\\]\"#=]*|[+-]?\\.(?:[^\\s\\\\/(){};\\[\\]\"#=0-9][^\\s\\\\/(){};\\[\\]\"#=]*)?|[+-](?:[^\\s\\\\/(){};\\[\\]\"#=0-9.][^\\s\\\\/(){};\\[\\]\"#=]*)?)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.kdl"
            },
            "2": {
              "name": "keyword.operator.assignment.kdl"
            }
          }
        }
      ]
    },
    "type-annotation": {
      "patterns": [
        {
          "match": "(\\()(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*((#+)\"(?:(?!\"\\3)[^\\r\\n])*\"\\3)(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*(\\))",
          "captures": {
            "1": {
              "name": "punctuation.definition.type.begin.kdl"
            },
            "2": {
              "name": "entity.name.type.kdl"
            },
            "4": {
              "name": "punctuation.definition.type.end.kdl"
            }
          }
        },
        {
          "match": "(\\()(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*(\"(?:\\\\.|[^\"\\\\\\r\\n])*\"|(?<![^\\s\\\\/(){};\\[\\]\"#=])(?!(?:true|false|null|nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[^\\s\\\\/(){};\\[\\]\"#=0-9+\\-.][^\\s\\\\/(){};\\[\\]\"#=]*|[+-]?\\.(?:[^\\s\\\\/(){};\\[\\]\"#=0-9][^\\s\\\\/(){};\\[\\]\"#=]*)?|[+-](?:[^\\s\\\\/(){};\\[\\]\"#=0-9.][^\\s\\\\/(){};\\[\\]\"#=]*)?)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[ \\t]+|/\\*[^*]*(?:\\*(?!/)[^*]*)*\\*/)*(\\))",
          "captures": {
            "1": {
              "name": "punctuation.definition.type.begin.kdl"
            },
            "2": {
              "name": "entity.name.type.kdl"
            },
            "3": {
              "name": "punctuation.definition.type.end.kdl"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "(#+)(\"\"\")(?=\\r?\\n)",
          "end": "\\2\\1",
          "name": "string.quoted.other.raw.multiline.kdl"
        },
        {
          "begin": "(#+)(\")",
          "end": "\"\\1",
          "name": "string.quoted.other.raw.kdl"
        },
        {
          "begin": "\"\"\"(?=\\r?\\n)",
          "end": "\"\"\"",
          "name": "string.quoted.triple.kdl",
          "patterns": [
            {
