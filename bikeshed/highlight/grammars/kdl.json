          ]
        },
        {
          "begin": "\"",
          "end": "\"|(?=\\r?\\n)",
          "name": "string.quoted.double.kdl",
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        }
      ]
    },
    "string-escapes": {
      "match": "\\\\(?:[\"\\\\bfnrst]|u\\{[0-9A-Fa-f]{1,6}\\}|[\\s]+)",
      "name": "constant.character.escape.kdl"
    },
    "keywords": {
      "patterns": [
        {
          "match": "#(?:true|false)(?![^\\s\\\\/(){};\\[\\]\"#=])",
          "name": "constant.language.boolean.kdl"
        },
        {
          "match": "#null(?![^\\s\\\\/(){};\\[\\]\"#=])",
          "name": "constant.language.null.kdl"
        },
        {
          "match": "#(?:nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=])",
          "name": "constant.numeric.float.keyword.kdl"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?<![^\\s\\\\/(){};\\[\\]\"#=])[+-]?0x[0-9A-Fa-f][0-9A-Fa-f_]*(?![^\\s\\\\/(){};\\[\\]\"#=])",
          "name": "constant.numeric.hex.kdl"
        },
        {
          "match": "(?<![^\\s\\\\/(){};\\[\\]\"#=])[+-]?0o[0-7][0-7_]*(?![^\\s\\\\/(){};\\[\\]\"#=])",
          "name": "constant.numeric.octal.kdl"
        },
        {
          "match": "(?<![^\\s\\\\/(){};\\[\\]\"#=])[+-]?0b[01][01_]*(?![^\\s\\\\/(){};\\[\\]\"#=])",
          "name": "constant.numeric.binary.kdl"
        },
        {
          "match": "(?<![^\\s\\\\/(){};\\[\\]\"#=])[+-]?[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)(?![^\\s\\\\/(){};\\[\\]\"#=])",
          "name": "constant.numeric.float.kdl"
        },
        {
          "match": "(?<![^\\s\\\\/(){};\\[\\]\"#=])[+-]?[0-9][0-9_]*(?![^\\s\\\\/(){};\\[\\]\"#=])",
          "name": "constant.numeric.decimal.kdl"
        }
      ]
    },
    "ident-string": {
      "match": "(?<![^\\s\\\\/(){};\\[\\]\"#=])(?!(?:true|false|null|nan|-?inf)(?![^\\s\\\\/(){};\\[\\]\"#=]))(?:[^\\s\\\\/(){};\\[\\]\"#=0-9+\\-.][^\\s\\\\/(){};\\[\\]\"#=]*|[+-]?\\.(?:[^\\s\\\\/(){};\\[\\]\"#=0-9][^\\s\\\\/(){};\\[\\]\"#=]*)?|[+-](?:[^\\s\\\\/(){};\\[\\]\"#=0-9.][^\\s\\\\/(){};\\[\\]\"#=]*)?)(?![^\\s\\\\/(){};\\[\\]\"#=])",
      "name": "string.unquoted.kdl"
