{
  "patterns": [
    {
      "match": "^#!.*$",
      "name": "comment.line.shebang"
    },
    {
      "match": "(?!^#!)#.*$",
      "name": "comment.line.number-sign"
    },
    {
      "match": "'(?:[^']*)'",
      "name": "string.quoted.single"
    },
    {
      "match": "\"(?:\\\\.|[^\"\\\\])*\"",
      "name": "string.quoted.double"
    },
    {
      "match": "\\$[a-zA-Z_][\\w]*|\\$\\d+|\\$[?@*#$!_-]|\\$\\{[^}]+\\}",
      "name": "entity.name.variable"
    },
    {
      "captures": {
        "1": {
          "name": "entity.name.variable.assignment"
        }
      },
      "match": "\\b([a-zA-Z_][\\w]*)(?==)"
    },
    {
      "match": "\\b(?:if|then|else|elif|fi|for|while|until|in|do|done|case|esac|function|select|time|coproc)\\b",
      "name": "keyword.control"
    },
    {
      "match": "(?:&&|\\|\\||[|&;])",
      "name": "keyword.operator"
    },
    {
      "match": "(?<![\\w-])--?[a-zA-Z][\\w-]*(?:=[^\\s]+)?",
      "name": "constant.language.option"
    },
    {
      "match": "(?<![\\w.])-?\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric"
    }
  ],
  "scopeName": "source.shell"
}
