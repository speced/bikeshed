{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function-call"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "--.*$",
          "name": "comment.line.double-dash"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:true|TRUE|false|FALSE)\\b",
          "name": "constant.language.boolean"
        },
        {
          "match": "\\b(?:null|NULL)\\b",
          "name": "constant.language"
        }
      ]
    },
    "function-call": {
      "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()",
      "name": "entity.name.function"
    },
    "keywords": {
      "match": "\\b(?:select|SELECT|insert|INSERT|update|UPDATE|delete|DELETE|from|FROM|where|WHERE|join|JOIN|inner|INNER|left|LEFT|right|RIGHT|full|FULL|outer|OUTER|cross|CROSS|on|ON|group|GROUP|by|BY|order|ORDER|having|HAVING|limit|LIMIT|offset|OFFSET|union|UNION|all|ALL|distinct|DISTINCT|as|AS|and|AND|or|OR|not|NOT|is|IS|in|IN|like|LIKE|between|BETWEEN|exists|EXISTS|case|CASE|when|WHEN|then|THEN|else|ELSE|end|END|with|WITH|into|INTO|values|VALUES|set|SET|create|CREATE|table|TABLE|alter|ALTER|drop|DROP|add|ADD|column|COLUMN|index|INDEX|view|VIEW|primary|PRIMARY|key|KEY|foreign|FOREIGN|references|REFERENCES|constraint|CONSTRAINT|default|DEFAULT|unique|UNIQUE|check|CHECK|cascade|CASCADE|trigger|TRIGGER|procedure|PROCEDURE|function|FUNCTION|returns|RETURNS|begin|BEGIN|commit|COMMIT|rollback|ROLLBACK|transaction|TRANSACTION|grant|GRANT|revoke|REVOKE|asc|ASC|desc|DESC|if|IF)\\b",
      "name": "keyword.control"
    },
    "numbers": {
      "match": "(?<![\\w.])-?\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "(?:<>|!=|<=|>=|\\|\\||[=<>+\\-*/%])",
      "name": "keyword.operator"
    },
    "strings": {
      "patterns": [
        {
          "match": "'(?:''|\\\\.|[^'\\\\])*'",
          "name": "string.quoted.single"
        },
        {
          "match": "\"(?:\"\"|[^\"])*\"",
          "name": "string.quoted.double"
        }
      ]
    },
    "types": {
      "match": "\\b(?:int|INT|integer|INTEGER|bigint|BIGINT|smallint|SMALLINT|tinyint|TINYINT|decimal|DECIMAL|numeric|NUMERIC|float|FLOAT|double|DOUBLE|real|REAL|boolean|BOOLEAN|bit|BIT|char|CHAR|varchar|VARCHAR|text|TEXT|date|DATE|datetime|DATETIME|timestamp|TIMESTAMP|time|TIME|blob|BLOB|json|JSON|uuid|UUID|serial|SERIAL)\\b",
      "name": "support.class.builtin"
    }
  },
  "scopeName": "source.sql"
}
