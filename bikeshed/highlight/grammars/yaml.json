{
  "patterns": [
    {
      "match": "#.*$",
      "name": "comment.line.number-sign"
    },
    {
      "match": "^(?:---|\\.\\.\\.)\\s*$|^%YAML\\b.*$",
      "name": "keyword.control.document"
    },
    {
      "captures": {
        "1": {
          "name": "entity.name.key"
        }
      },
      "match": "^\\s*(?:-\\s+)?([^#\\s][^\\r\\n:#]*?)(?=\\s*:)"
    },
    {
      "match": "[&*][a-zA-Z_][\\w-]*|![^\\s]+",
      "name": "entity.name.anchor"
    },
    {
      "match": "(['\"])(?:\\\\.|(?!\\1)[^\\\\\\r\\n]|\\r?\\n[ \\t]+)*\\1",
      "name": "string.quoted"
    },
    {
      "match": "(?<=:\\s)[|>][-+]?\\s*$",
      "name": "keyword.control.block-scalar"
    },
    {
      "match": "\\b(?:true|false|yes|no|on|off)\\b",
      "name": "constant.language.boolean"
    },
    {
      "match": "\\bnull\\b|~",
      "name": "constant.language"
    },
    {
      "match": "(?<![\\w.-])-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:e[+-]?\\d+)?\\b",
      "name": "constant.numeric"
    }
  ],
  "scopeName": "source.yaml"
}
