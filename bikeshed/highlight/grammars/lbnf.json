{
  "scopeName": "source.lbnf",
  "name": "Labelled Backus-Naur Form",
  "fileTypes": [
    "cf",
    "lbnf"
  ],
  "patterns": [
    {
      "include": "#main"
    }
  ],
  "repository": {
    "main": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#pragmas"
        },
        {
          "include": "#label"
        },
        {
          "include": "#definition"
        },
        {
          "include": "#rhs"
        }
      ]
    },
    "braces": {
      "name": "meta.braces.lbnf",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.curly.bracket.begin.lbnf"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.curly.bracket.end.lbnf"
        }
      },
      "patterns": [
        {
          "include": "#rhs"
        }
      ]
    },
    "character": {
      "name": "string.quoted.single.character.lbnf",
      "match": "(').(')",
      "captures": {
        "1": {
          "name": "punctuation.definition.string.begin.lbnf"
        },
        "2": {
          "name": "punctuation.definition.string.end.lbnf"
        }
      }
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.lbnf",
          "begin": "--",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.lbnf"
            }
          }
        },
        {
          "name": "comment.block.lbnf",
          "begin": "\\{-",
          "end": "-\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.lbnf"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.lbnf"
            }
          }
        }
      ]
    },
    "definition": {
      "name": "keyword.operator.assignment.lbnf",
      "match": "::="
    },
    "label": {
      "patterns": [
        {
          "match": "^[ \\t]*((?!\\d)\\w+)[ \\t]*(\\.)[ \\t]*((?!\\d)\\w+)?",
          "captures": {
            "1": {
              "name": "entity.name.function.lbnf"
            },
            "2": {
              "name": "keyword.operator.label-separator.lbnf"
            },
            "3": {
              "name": "entity.name.tag.category.lbnf"
            }
          }
        },
        {
          "match": "(?<=\\]|\\))[ \\t]*(\\.)[ \\t]*((?!\\d)\\w+)?",
          "captures": {
            "1": {
              "name": "keyword.operator.label-separator.lbnf"
            },
            "2": {
              "name": "entity.name.tag.category.lbnf"
            }
          }
        }
      ]
    },
    "list": {
      "patterns": [
        {
          "name": "meta.list.cons-rule.lbnf",
          "match": "(\\()(:)(\\))",
          "captures": {
            "1": {
              "name": "punctuation.section.round.bracket.begin.lbnf"
            },
            "2": {
              "name": "punctuation.definition.cons-rule.colon.lbnf"
            },
            "3": {
              "name": "punctuation.section.round.bracket.end.lbnf"
            }
          }
        },
        {
          "name": "meta.list.one-element.lbnf",
          "match": "(\\()(:)(\\[)(\\])(\\))",
          "captures": {
            "1": {
              "name": "punctuation.section.round.bracket.begin.lbnf"
            },
            "2": {
              "name": "punctuation.definition.cons-rule.colon.lbnf"
            },
            "3": {
              "name": "punctuation.section.group.square.bracket.begin.lbnf"
            },
            "4": {
              "name": "punctuation.section.group.square.bracket.end.lbnf"
            },
            "5": {
              "name": "punctuation.section.round.bracket.end.lbnf"
            }
          }
        },
        {
          "name": "meta.list.empty.lbnf",
          "match": "(\\[)(\\])",
          "captures": {
            "1": {
              "name": "punctuation.section.group.square.bracket.begin.lbnf"
            },
            "2": {
              "name": "punctuation.section.group.square.bracket.end.lbnf"
            }
          }
        },
        {
          "name": "meta.list.lbnf",
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.group.square.bracket.begin.lbnf"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.square.bracket.end.lbnf"
            }
          },
          "patterns": [
            {
              "include": "#rhs"
            }
          ]
        },
        {
          "name": "meta.list.parenthetical.lbnf",
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.round.bracket.begin.lbnf"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.round.bracket.end.lbnf"
            }
          },
          "patterns": [
            {
              "include": "#rhs"
            }
          ]
        }
      ]
    },
    "misc-keywords": {
      "name": "keyword.operator.reserved-word.lbnf",
      "match": "\\b(?:char|coercions|comment|digit|entrypoints|eps|internal|layout|letter|lower|nonempty|position|rules|separator|stop|terminator|token|toplevel|upper)\\b"
    },
    "misc-operators": {
      "patterns": [
        {
          "match": ":",
          "name": "punctuation.definition.cons-rule.colon.lbnf"
        },
        {
          "match": ",",
          "name": "punctuation.delimiter.comma.lbnf"
        },
        {
          "match": "-",
          "name": "keyword.operator.arithmetic.subtraction.lbnf"
        },
        {
          "match": "[|*+?]",
          "name": "keyword.operator.logical.lbnf"
        }
      ]
    },
    "number": {
      "name": "constant.numeric.decimal.lbnf",
      "match": "(?<![\\w.])-?\\d+(?:\\.\\d+)?\\b"
    },
    "pragmas": {
      "patterns": [
        {
          "match": "^[ \\t]*(rules)[ \\t]+(\\w+)[ \\t]*(?=::=)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.pragma.rules.lbnf"
            },
            "2": {
              "name": "entity.name.type.lbnf"
            }
          }
        },
        {
          "match": "^[ \\t]*(comment|coercions|entrypoints|layout(?:[ \\t]+(?:stop|toplevel))?|(?:position[ \\t]+)?token|rules|separator|terminator)(?=[ \\t]|$)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.pragma.lbnf"
            }
          }
        }
      ]
    },
    "rhs": {
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#character"
        },
        {
          "include": "#semicolon"
        },
        {
          "include": "#misc-keywords"
        },
        {
          "include": "#misc-operators"
        },
        {
          "include": "#list"
        },
        {
          "include": "#number"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#braces"
        },
        {
          "include": "#reference"
        }
      ]
    },
    "reference": {
      "name": "entity.name.tag.reference.lbnf",
      "match": "(?!\\d)\\w+"
    },
    "semicolon": {
      "name": "punctuation.terminator.statement.semicolon.lbnf",
      "match": ";"
    },
    "string": {
      "name": "string.quoted.double.lbnf",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.lbnf"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.lbnf"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.quote.lbnf",
          "match": "\\\\."
        }
      ]
    }
  }
}
