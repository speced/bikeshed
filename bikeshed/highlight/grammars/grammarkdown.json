{
  "scopeName": "text.grammarkdown",
  "name": "Grammarkdown",
  "fileTypes": [
    "grammar"
  ],
  "patterns": [
    {
      "include": "#main"
    }
  ],
  "repository": {
    "main": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#meta"
        },
        {
          "include": "#production-header"
        },
        {
          "include": "#production-innards"
        }
      ]
    },
    "assertion": {
      "name": "meta.assertion.grammarkdown",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.assertion.begin.grammarkdown"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.assertion.end.grammarkdown"
        }
      },
      "patterns": [
        {
          "name": "markup.quote.prose.grammarkdown",
          "begin": "(>)[ \\t]*",
          "end": "[ \\t]*(?=\\])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.quote.grammarkdown"
            }
          }
        },
        {
          "name": "keyword.operator.assertion.grammarkdown",
          "match": "\\b(?:empty|lookahead|lexical[ \\t]+goal|no|here)\\b"
        },
        {
          "name": "keyword.operator.comparison.equality.grammarkdown",
          "match": "==|!=|≠|<-|<!|∈|∉"
        },
        {
          "name": "keyword.operator.parameter-test.grammarkdown",
          "match": "[+~?]"
        },
        {
          "include": "#literal"
        },
        {
          "include": "#comma"
        },
        {
          "match": "[{}]",
          "name": "punctuation.definition.set.grammarkdown"
        },
        {
          "name": "variable.parameter.grammarkdown",
          "match": "\\w+"
        }
      ]
    },
    "comma": {
      "name": "punctuation.delimiter.comma.grammarkdown",
      "match": ","
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.grammarkdown",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.grammarkdown"
            }
          }
        },
        {
          "name": "comment.block.grammarkdown",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.grammarkdown"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.grammarkdown"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.operator.logical.negation.grammarkdown",
          "match": "\\bbut[ \\t]+not\\b"
        },
        {
          "name": "keyword.operator.selection.one-of.grammarkdown",
          "match": "\\bone[ \\t]+of\\b"
        },
        {
          "name": "keyword.operator.range.grammarkdown",
          "match": "\\bthrough\\b"
        },
        {
          "name": "keyword.operator.logical.or.grammarkdown",
          "match": "\\bor\\b"
        }
      ]
    },
    "link-id": {
      "name": "constant.other.permalink.grammarkdown",
      "match": "(#)([-\\w]+)",
      "captures": {
        "1": {
          "name": "punctuation.definition.permalink.grammarkdown"
        },
        "2": {
          "name": "constant.other.reference.link.permalink.grammarkdown"
        }
      }
    },
    "literal": {
      "patterns": [
        {
          "name": "string.quoted.single.verbatim.grammarkdown",
          "match": "(`)`(`)",
          "captures": {
            "1": {
              "name": "punctuation.definition.string.begin.grammarkdown"
            },
            "2": {
              "name": "punctuation.definition.string.end.grammarkdown"
            }
          }
        },
        {
          "name": "string.quoted.verbatim.grammarkdown",
          "begin": "`",
          "end": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.grammarkdown"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.grammarkdown"
            }
          }
        }
      ]
    },
    "meta": {
      "patterns": [
        {
          "name": "meta.import.directive.grammarkdown",
          "begin": "^[ \\t]*((@)import)(?=$|[ \\t])",
          "end": "(?=[ \\t]*(?:$|/[/*]))",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.grammarkdown"
            },
            "2": {
              "name": "punctuation.definition.keyword.grammarkdown"
            }
          },
          "patterns": [
            {
              "include": "#meta-string"
            }
          ]
        },
        {
          "name": "meta.source-line.directive.grammarkdown",
          "begin": "^[ \\t]*((@)line)(?=$|[ \\t])",
          "end": "(?=[ \\t]*(?:$|/[/*]))",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.line.grammarkdown"
            },
            "2": {
              "name": "punctuation.definition.keyword.grammarkdown"
            }
          },
          "patterns": [
            {
              "match": "\\b\\d+\\b",
              "name": "constant.numeric.decimal.integer.line-number.grammarkdown"
            },
            {
              "include": "#meta-string"
            }
          ]
        },
        {
          "name": "meta.define.directive.grammarkdown",
          "match": "^[ \\t]*((@)define)(?=$|[ \\t])[ \\t]*(\\w+)(?:[ \\t]+(?:(default)|(true|false)|((?:[^\\r\\n/]|/(?!/|\\*))+)))?",
          "captures": {
            "1": {
              "name": "keyword.control.define.grammarkdown"
            },
            "2": {
              "name": "punctuation.definition.keyword.grammarkdown"
            },
            "3": {
              "name": "variable.assignment.setting-name.grammarkdown"
            },
            "4": {
              "name": "constant.language.default.grammarkdown"
            },
            "5": {
              "name": "constant.language.boolean"
            },
            "6": {
              "name": "string.unquoted.setting-value.grammarkdown"
            }
          }
        }
      ]
    },
    "meta-string": {
      "patterns": [
        {
          "name": "string.quoted.double.grammarkdown",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.grammarkdown"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.grammarkdown"
            }
          }
        },
        {
          "name": "string.quoted.single.grammarkdown",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.grammarkdown"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.grammarkdown"
            }
          }
        }
      ]
    },
    "optional": {
      "name": "keyword.operator.quantifier.optional.grammarkdown",
      "match": "(?<=\\S)[ \\t]*\\?"
    },
    "production-header": {
      "patterns": [
        {
          "match": "^[ \\t]*(\\w+)(?=[ \\t]*(?:\\[[^\\]\\r\\n]*\\][ \\t]*)?:{1,3})",
          "captures": {
            "1": {
              "name": "entity.name.type.grammarkdown"
            }
          }
        },
        {
          "match": ":{1,3}",
          "name": "keyword.operator.assignment.rule.grammarkdown"
        }
      ]
    },
    "production-innards": {
      "patterns": [
        {
          "include": "#prose"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#terminal"
        },
        {
          "include": "#optional"
        },
        {
          "include": "#link-id"
        },
        {
          "include": "#ref"
        }
      ]
    },
    "prose": {
      "name": "markup.quote.prose.grammarkdown",
      "begin": "^[ \\t]*(>)[ \\t]*",
      "end": "(?=[ \\t]*(?:$|/[/*]))",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.quote.grammarkdown"
        }
      }
    },
    "ref": {
      "name": "variable.reference.grammarkdown",
      "match": "\\b\\w+\\b"
    },
    "terminal": {
      "patterns": [
        {
          "include": "#assertion"
        },
        {
          "include": "#literal"
        },
        {
          "include": "#unicode-char"
        },
        {
          "include": "#unicode-codepoint"
        }
      ]
    },
    "unicode-char": {
      "name": "constant.character.named.unicode-name.grammarkdown",
      "match": "(<)([^<>\\r\\n]+)(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.character.begin.grammarkdown"
        },
        "2": {
          "name": "constant.character.named.unicode-name.grammarkdown"
        },
        "3": {
          "name": "punctuation.definition.character.end.grammarkdown"
        }
      }
    },
    "unicode-codepoint": {
      "name": "constant.numeric.other.codepoint.grammarkdown",
      "match": "U\\+[A-Fa-f0-9]+"
    }
  }
}
