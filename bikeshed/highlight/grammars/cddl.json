{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CDDL",
  "scopeName": "source.cddl",
  "fileTypes": ["cddl"],
  "patterns": [
    { "include": "#directives" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#byte-strings" },
    { "include": "#tags" },
    { "include": "#control-operators" },
    { "include": "#numbers" },
    { "include": "#prelude-types" },
    { "include": "#rule-definition" },
    { "include": "#sockets" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "directives": {
      "match": "^;#.*$",
      "name": "meta.preprocessor.cddl"
    },
    "comments": {
      "match": ";.*$",
      "name": "comment.line.semicolon.cddl"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.cddl",
      "patterns": [
        {
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4}|u\\{[0-9a-fA-F]+\\})",
          "name": "constant.character.escape.cddl"
        }
      ]
    },
    "byte-strings": {
      "patterns": [
        {
          "begin": "h'",
          "end": "'",
          "name": "string.other.byte.hex.cddl"
        },
        {
          "begin": "b64'",
          "end": "'",
          "name": "string.other.byte.base64.cddl"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.byte.cddl",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.cddl"
            }
          ]
        }
      ]
    },
    "tags": {
      "match": "#(?:6(?:\\.\\d+|\\.<[^>]+>)?|[0-57](?:\\.\\d+)?)",
      "name": "constant.other.tag.cddl"
    },
    "control-operators": {
      "match": "\\.(?:size|bits|regexp|pcre|iregexp|cbor|cborseq|within|and|lt|le|gt|ge|eq|ne|default|cat|det|plus|abnf|abnfb|feature|b64u|b64c|hex|hexlc|hexuc|b32|h32|b45|base10|printf|json|join|bitfield)\\b",
      "name": "keyword.operator.control.cddl"
    },
    "numbers": {
      "match": "(?<![A-Za-z0-9_-])-?(?:0x[0-9a-fA-F]+(?:\\.[0-9a-fA-F]+)?(?:[pP][+-]?\\d+)?|0b[01]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric.cddl"
    },
    "prelude-types": {
      "match": "(?<![A-Za-z0-9_-])(?:any|uint|nint|int|bstr|bytes|tstr|text|tdate|time|number|biguint|bignint|bigint|integer|unsigned|decfrac|bigfloat|eb64url|eb64legacy|eb16|encoded-cbor|uri|b64url|b64legacy|regexp|mime-message|cbor-any|float16|float32|float64|float16-32|float32-64|float|false|true|bool|nil|null|undefined)(?![A-Za-z0-9_-])",
      "name": "support.type.prelude.cddl"
    },
    "rule-definition": {
      "match": "^\\s*([A-Za-z@_$][A-Za-z0-9@_$\\.-]*)\\s*(?:(<[^>]+>))?\\s*(/=|//=|=)",
      "captures": {
        "1": { "name": "entity.name.type.cddl" },
        "2": { "name": "variable.parameter.generic.cddl" },
        "3": { "name": "keyword.operator.assignment.cddl" }
      }
    },
    "sockets": {
      "match": "\\$\\$?[A-Za-z@_$][A-Za-z0-9@_$\\.-]*",
      "name": "variable.other.socket.cddl"
    },
    "operators": {
      "match": "=>|//|\\^|\\*|\\+|\\?|\\.\\.\\.|\\.\\.|~|&|/",
      "name": "keyword.operator.cddl"
    },
    "identifiers": {
      "match": "[A-Za-z@_$][A-Za-z0-9@_$\\.-]*",
      "name": "variable.other.rule.cddl"
    }
  }
}
