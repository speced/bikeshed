{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#storage-types"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function-declaration"
    }
  ],
  "repository": {
    "builtin-types": {
      "match": "\\b(?:char|double|float|int|long|short|void|_Bool|int8_t|int16_t|int32_t|int64_t|uint8_t|uint16_t|uint32_t|uint64_t|size_t|ssize_t|ptrdiff_t|FILE)\\b",
      "name": "support.class.builtin"
    },
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block"
        }
      ]
    },
    "constants": {
      "match": "\\b(?:NULL|true|false)\\b",
      "name": "constant.language"
    },
    "function-declaration": {
      "match": "\\b([A-Za-z_]\\w*)(?=\\s*\\()",
      "name": "entity.name.function"
    },
    "keywords": {
      "match": "\\b(?:break|case|continue|default|do|else|for|goto|if|return|sizeof|switch|while)\\b",
      "name": "keyword.control"
    },
    "numbers": {
      "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F]+|0[bB][01]+|(?:\\d+\\.\\d*|\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?)[uUlLfF]*\\b",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "(?:->|\\+\\+|--|&&|\\|\\||<<=?|>>=?|==|!=|<=|>=|[+\\-*/%&|^!~<>=]=?)",
      "name": "keyword.operator"
    },
    "preprocessor": {
      "patterns": [
        {
          "begin": "^\\s*#\\s*include\\b",
          "end": "$",
          "name": "keyword.control.directive.include",
          "patterns": [
            {
              "match": "<[^>]*>",
              "name": "string.quoted.other.lt-gt"
            },
            {
              "match": "\"(?:\\\\.|[^\"\\\\\\r\\n])*\"",
              "name": "string.quoted.double"
            }
          ]
        },
        {
          "match": "^\\s*#\\s*(?:define|undef|ifdef|ifndef|if|elif|else|endif|pragma|error|warning|line)\\b.*$",
          "name": "keyword.control.directive"
        }
      ]
    },
    "storage-types": {
      "match": "\\b(?:auto|const|enum|extern|inline|register|restrict|signed|static|struct|typedef|union|unsigned|volatile)\\b",
      "name": "storage.modifier"
    },
    "strings": {
      "patterns": [
        {
          "match": "'(?:\\\\.|[^'\\\\\\r\\n])'",
          "name": "string.quoted.char"
        },
        {
          "match": "\"(?:\\\\.|[^\"\\\\\\r\\n])*\"",
          "name": "string.quoted.double"
        }
      ]
    }
  },
  "scopeName": "source.c"
}
