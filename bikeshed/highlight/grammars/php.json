{
  "patterns": [
    {
      "match": "<\\?php\\b|<\\?=|\\?>",
      "name": "punctuation.section.embedded"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#class-declaration"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function-call"
    }
  ],
  "repository": {
    "attributes": {
      "match": "#\\[[^\\]]*\\]",
      "name": "entity.name.decorator"
    },
    "class-declaration": {
      "captures": {
        "1": {
          "name": "storage.type.class"
        },
        "2": {
          "name": "entity.name.type.class"
        }
      },
      "match": "\\b(class|interface|trait|enum)\\s+([A-Za-z_]\\w*)"
    },
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash"
        },
        {
          "match": "#(?!\\[).*$",
          "name": "comment.line.number-sign"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:true|false|TRUE|FALSE)\\b",
          "name": "constant.language.boolean"
        },
        {
          "match": "\\b(?:null|NULL)\\b",
          "name": "constant.language"
        }
      ]
    },
    "function-call": {
      "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()",
      "name": "entity.name.function"
    },
    "function-declaration": {
      "captures": {
        "1": {
          "name": "storage.type.function"
        },
        "2": {
          "name": "entity.name.function"
        }
      },
      "match": "\\b(function)\\s+&?([A-Za-z_]\\w*)"
    },
    "keywords": {
      "match": "\\b(?:abstract|and|array|as|break|callable|case|catch|clone|const|continue|declare|default|do|echo|else|elseif|empty|enddeclare|endfor|endforeach|endif|endswitch|endwhile|extends|final|finally|fn|for|foreach|global|goto|if|implements|include|include_once|instanceof|insteadof|interface|isset|list|match|namespace|new|or|print|private|protected|public|readonly|require|require_once|return|static|switch|throw|trait|try|unset|use|var|while|xor|yield)\\b",
      "name": "keyword.control"
    },
    "numbers": {
      "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "(?:->|=>|::|\\?\\?=?|<=>|===|!==|==|!=|<=|>=|\\.=|&&|\\|\\||[+\\-*/%.!<>=]=?)",
      "name": "keyword.operator"
    },
    "strings": {
      "patterns": [
        {
          "match": "'(?:\\\\.|[^'\\\\])*'",
          "name": "string.quoted.single"
        },
        {
          "match": "\"(?:\\\\.|[^\"\\\\])*\"",
          "name": "string.quoted.double"
        }
      ]
    },
    "variables": {
      "match": "\\$[A-Za-z_]\\w*",
      "name": "entity.name.variable"
    }
  },
  "scopeName": "source.php"
}
