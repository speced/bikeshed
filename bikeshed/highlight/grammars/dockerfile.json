{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#from-instruction"
    },
    {
      "include": "#instructions"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#flags"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "match": "^\\s*#.*$",
      "name": "comment.line.number-sign"
    },
    "flags": {
      "match": "--[a-zA-Z][\\w-]*(?:=[^\\s]+)?",
      "name": "constant.language.option"
    },
    "from-instruction": {
      "captures": {
        "1": {
          "name": "keyword.control"
        },
        "2": {
          "name": "keyword.control"
        },
        "3": {
          "name": "entity.name.type.class"
        }
      },
      "match": "^\\s*(FROM|from)\\b(?:.*?\\b(AS|as)\\s+([A-Za-z0-9_.-]+))?"
    },
    "instructions": {
      "match": "^\\s*(?:ADD|ARG|CMD|COPY|ENTRYPOINT|ENV|EXPOSE|HEALTHCHECK|LABEL|MAINTAINER|ONBUILD|RUN|SHELL|STOPSIGNAL|USER|VOLUME|WORKDIR|add|arg|cmd|copy|entrypoint|env|expose|healthcheck|label|maintainer|onbuild|run|shell|stopsignal|user|volume|workdir)\\b",
      "name": "keyword.control"
    },
    "numbers": {
      "match": "(?<![\\w.])\\d+\\b",
      "name": "constant.numeric"
    },
    "strings": {
      "patterns": [
        {
          "match": "'(?:\\\\.|[^'\\\\])*'",
          "name": "string.quoted.single"
        },
        {
          "match": "\"(?:\\\\.|[^\"\\\\])*\"",
          "name": "string.quoted.double"
        }
      ]
    },
    "variables": {
      "match": "\\$\\{?[A-Za-z_][\\w]*\\}?",
      "name": "entity.name.variable"
    }
  },
  "scopeName": "source.dockerfile"
}
