{
  "dependencies": [
    "html",
    "css",
    "scss",
    "javascript",
    "typescript"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#typescript"
    },
    {
      "include": "#javascript"
    },
    {
      "include": "#scss"
    },
    {
      "include": "#css"
    },
    {
      "include": "#blocks"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#tags"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "blocks": {
      "captures": {
        "1": {
          "name": "punctuation.definition.keyword"
        },
        "2": {
          "name": "keyword.control"
        }
      },
      "match": "\\{([#/:@])\\s*(if|else|each|key|await|then|catch|snippet|render|html|debug|const)\\b"
    },
    "comments": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block"
    },
    "css": {
      "begin": "<(style)\\b[^>]*>",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "contentName": "source.css.embedded.svelte",
      "end": "</(style)\\s*>",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "patterns": [
        {
          "include": "source.css"
        }
      ]
    },
    "directive": {
      "captures": {
        "1": {
          "name": "entity.other.attribute-name"
        }
      },
      "match": "[ \\t]+((?:bind|on|class|use|transition|in|out|animate|let):[\\w-]+(?:\\|[\\w-]+)*)"
    },
    "interpolation": {
      "begin": "\\{(?![#/:@])",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin"
        }
      },
      "contentName": "source.js.embedded.svelte",
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end"
        }
      },
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "javascript": {
      "begin": "<(script)\\b[^>]*>",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "contentName": "source.js.embedded.svelte",
      "end": "</(script)\\s*>",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "scss": {
      "begin": "<(style)\\b(?=[^>]*\\blang\\s*=\\s*(['\"])scss\\2)[^>]*>",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "contentName": "source.css.scss.embedded.svelte",
      "end": "</(style)\\s*>",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "patterns": [
        {
          "include": "source.scss"
        }
      ]
    },
    "shorthand": {
      "begin": "[ \\t]+\\{",
      "contentName": "source.js.embedded.svelte",
      "end": "\\}",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "tags": {
      "begin": "<(/?)([a-zA-Z][\\w.:-]*)",
      "beginCaptures": {
        "2": {
          "name": "entity.name.tag"
        }
      },
      "end": ">",
      "patterns": [
        {
          "include": "#directive"
        },
        {
          "include": "#shorthand"
        },
        {
          "include": "text.html.basic#inline-css"
        },
        {
          "include": "text.html.basic#attributes"
        },
        {
          "include": "text.html.basic#unquoted-attributes"
        },
        {
          "include": "text.html.basic#boolean-attributes"
        }
      ]
    },
    "typescript": {
      "begin": "<(script)\\b(?=[^>]*\\blang\\s*=\\s*(['\"])(?:ts|typescript)\\2)[^>]*>",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "contentName": "source.ts.embedded.svelte",
      "end": "</(script)\\s*>",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "patterns": [
        {
          "include": "source.ts"
        }
      ]
    }
  },
  "scopeName": "source.svelte"
}
