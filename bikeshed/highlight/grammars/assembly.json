{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#label-declaration"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#instructions"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "match": ";.*$",
      "name": "comment.line.semicolon"
    },
    "directives": {
      "match": "\\b(?:section|segment|global|extern|bits|default|org|align|times|equ|struc|endstruc|incbin|db|dw|dd|dq|dt|resb|resw|resd|resq|rest|resy|resz)\\b",
      "name": "keyword.control.directive"
    },
    "instructions": {
      "match": "\\b(?:mov|movzx|movsx|lea|push|pop|add|sub|mul|imul|div|idiv|inc|dec|neg|and|or|xor|not|shl|shr|sal|sar|rol|ror|rcl|rcr|cmp|test|jmp|je|jne|jz|jnz|jg|jge|jl|jle|ja|jae|jb|jbe|jc|jnc|jo|jno|js|jns|jp|jnp|call|ret|retn|retf|nop|int|int3|syscall|sysenter|leave|enter|cld|std|cli|sti|hlt|lock|rep|repe|repz|repne|repnz|cpuid|in|out|xchg|cbw|cwde|cdqe|cwd|cdq|cqo|adc|sbb|xadd|cmpxchg|bt|bts|btr|btc|bsf|bsr|setz|setnz|sete|setne|lodsb|lodsw|lodsd|lodsq|stosb|stosw|stosd|stosq|movsb|movsw|movsd|movsq|cmpsb|cmpsw|cmpsd|cmpsq|scasb|scasw|scasd|scasq|fld|fst|fstp|fadd|fsub|fmul|fdiv|pushf|popf|pusha|popa)\\b",
      "name": "keyword.control"
    },
    "label-declaration": {
      "captures": {
        "1": {
          "name": "entity.name.function"
        }
      },
      "match": "^\\s*([.$?@A-Za-z_][\\w.$?@]*)\\s*:"
    },
    "numbers": {
      "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F]+|0[bB][01]+|[0-9][0-9a-fA-F]*[hH]\\b|[01]+[bB]\\b|\\d+[dD]?\\b)",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "(?:<<|>>|&&|\\|\\||[+\\-*/%&|^~,])",
      "name": "keyword.operator"
    },
    "preprocessor": {
      "match": "^\\s*%(?:define|undef|macro|endmacro|include|if|ifdef|ifndef|elif|else|endif|assign|strlen|substr)\\b.*$",
      "name": "keyword.control.directive"
    },
    "registers": {
      "match": "\\b(?:rax|rbx|rcx|rdx|rsi|rdi|rbp|rsp|eax|ebx|ecx|edx|esi|edi|ebp|esp|ax|bx|cx|dx|si|di|bp|sp|al|ah|bl|bh|cl|ch|dl|dh|sil|dil|bpl|spl|cs|ds|es|fs|gs|ss|rip|r(?:8|9|1[0-5])[dwb]?|xmm(?:[0-9]|1[0-5])|ymm(?:[0-9]|1[0-5])|zmm(?:[0-9]|1[0-9]|2[0-9]|3[01])|st[0-7]?|mm[0-7])\\b",
      "name": "support.class.builtin"
    },
    "strings": {
      "patterns": [
        {
          "match": "'(?:\\\\.|[^'\\\\\\r\\n])*'",
          "name": "string.quoted.single"
        },
        {
          "match": "\"(?:\\\\.|[^\"\\\\\\r\\n])*\"",
          "name": "string.quoted.double"
        }
      ]
    }
  },
  "scopeName": "source.asm.x86"
}
