{
  "dependencies": [
    "css",
    "json",
    "javascript"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#doctype"
    },
    {
      "include": "#embedded-css"
    },
    {
      "include": "#embedded-json"
    },
    {
      "include": "#embedded-javascript"
    },
    {
      "include": "#raw-text"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#entities"
    }
  ],
  "repository": {
    "attributes": {
      "begin": "[ \\t]+([a-zA-Z_:][\\w:.-]*)\\s*=\\s*(['\"])",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name"
        },
        "2": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "contentName": "string.quoted.attribute-value",
      "end": "\\2",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "include": "#entities"
        }
      ]
    },
    "boolean-attributes": {
      "captures": {
        "1": {
          "name": "entity.other.attribute-name"
        }
      },
      "match": "[ \\t]+([a-zA-Z_:][\\w:.-]*)(?=[ \\t]*/?>|[ \\t]+[a-zA-Z_:])"
    },
    "comments": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block"
    },
    "doctype": {
      "match": "<![Dd][Oo][Cc][Tt][Yy][Pp][Ee]\\b[^>]*>",
      "name": "keyword.control.doctype"
    },
    "embedded-css": {
      "begin": "<([Ss][Tt][Yy][Ll][Ee])\\b(?:\"[^\"]*\"|'[^']*'|[^'\">])*>",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "contentName": "source.css.embedded.html",
      "end": "</([Ss][Tt][Yy][Ll][Ee])[ \\t]*>",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "patterns": [
        {
          "include": "source.css"
        }
      ]
    },
    "embedded-javascript": {
      "begin": "<([Ss][Cc][Rr][Ii][Pp][Tt])\\b(?:(?![^>]*\\b[Tt][Yy][Pp][Ee]\\s*=)|(?=[^>]*\\b[Tt][Yy][Pp][Ee]\\s*=\\s*(['\"])(?:module|(?:text|application)/(?:java|ecma)script)\\2))(?:\"[^\"]*\"|'[^']*'|[^'\">])*>",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "contentName": "source.js.embedded.html",
      "end": "</([Ss][Cc][Rr][Ii][Pp][Tt])[ \\t]*>",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "embedded-json": {
      "begin": "<([Ss][Cc][Rr][Ii][Pp][Tt])\\b(?=[^>]*\\b[Tt][Yy][Pp][Ee]\\s*=\\s*(['\"])(?:application/(?:ld\\+)?json|importmap|speculationrules)\\2)(?:\"[^\"]*\"|'[^']*'|[^'\">])*>",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "contentName": "source.json.embedded.html",
      "end": "</([Ss][Cc][Rr][Ii][Pp][Tt])[ \\t]*>",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "patterns": [
        {
          "include": "source.json"
        }
      ]
    },
    "entities": {
      "match": "&(?:#\\d+|#x[0-9a-fA-F]+|[a-zA-Z][\\w]+);",
      "name": "constant.character.entity"
    },
    "inline-css": {
      "begin": "[ \\t]+(style)\\s*=\\s*(['\"])",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name"
        },
        "2": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "contentName": "source.css.embedded.inline",
      "end": "\\2",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "include": "source.css#comments"
        },
        {
          "include": "source.css#strings"
        },
        {
          "include": "source.css#declarations"
        },
        {
          "include": "source.css#values"
        }
      ]
    },
    "inline-javascript": {
      "begin": "[ \\t]+(on[a-zA-Z][\\w-]*)\\s*=\\s*(['\"])",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name"
        },
        "2": {
          "name": "punctuation.definition.string.begin"
        }
      },
      "contentName": "source.js.embedded.inline",
      "end": "\\2",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end"
        }
      },
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "raw-text": {
      "begin": "<([Tt][Ee][Xx][Tt][Aa][Rr][Ee][Aa]|[Tt][Ii][Tt][Ll][Ee])\\b(?:\"[^\"]*\"|'[^']*'|[^'\">])*>",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      },
      "contentName": "string.unquoted.raw-text",
      "end": "</([Tt][Ee][Xx][Tt][Aa][Rr][Ee][Aa]|[Tt][Ii][Tt][Ll][Ee])[ \\t]*>",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag"
        }
      }
    },
    "tags": {
      "begin": "<(/?)([a-zA-Z][\\w.-]*)",
      "beginCaptures": {
        "2": {
          "name": "entity.name.tag"
        }
      },
      "end": ">",
      "patterns": [
        {
          "include": "#inline-css"
        },
        {
          "include": "#inline-javascript"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#unquoted-attributes"
        },
        {
          "include": "#boolean-attributes"
        }
      ]
    },
    "unquoted-attributes": {
      "captures": {
        "1": {
          "name": "entity.other.attribute-name"
        },
        "2": {
          "name": "string.unquoted.attribute-value"
        }
      },
      "match": "[ \\t]+([a-zA-Z_:][\\w:.-]*)\\s*=\\s*([^\\s\"'`=<>]+)"
    }
  },
  "scopeName": "text.html.basic"
}
