{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#table-headers"
    },
    {
      "include": "#datetime"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keys"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign"
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:true|false)\\b",
          "name": "constant.language.boolean"
        },
        {
          "match": "\\b(?:inf|nan)\\b",
          "name": "constant.language"
        }
      ]
    },
    "datetime": {
      "match": "\\b\\d{4}-\\d{2}-\\d{2}(?:[Tt ]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})?)?\\b",
      "name": "constant.other.date-time"
    },
    "keys": {
      "captures": {
        "1": {
          "name": "entity.name.key"
        }
      },
      "match": "^\\s*((?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:\\\\.|[^\"\\\\])*\"|'[^']*'))*)\\s*(?==)"
    },
    "numbers": {
      "match": "(?<![\\w.])[+-]?(?:0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "=",
      "name": "keyword.operator"
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple.double"
        },
        {
          "begin": "'''",
          "end": "'''",
          "name": "string.quoted.triple.single"
        },
        {
          "match": "\"(?:\\\\.|[^\"\\\\\\r\\n])*\"",
          "name": "string.quoted.double"
        },
        {
          "match": "'[^'\\r\\n]*'",
          "name": "string.quoted.single"
        }
      ]
    },
    "table-headers": {
      "captures": {
        "1": {
          "name": "punctuation.definition.table"
        },
        "2": {
          "name": "entity.name.type.class"
        },
        "3": {
          "name": "punctuation.definition.table"
        }
      },
      "match": "^\\s*(\\[\\[?)([^\\[\\]]+)(\\]\\]?)\\s*$"
    }
  },
  "scopeName": "source.toml"
}
