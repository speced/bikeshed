{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#pod"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "builtins": {
      "match": "\\b(?:print|printf|sprintf|push|pop|shift|unshift|splice|join|split|map|grep|sort|keys|values|each|defined|exists|delete|ref|bless|die|warn|chomp|chop|length|substr|index|lc|uc|lcfirst|ucfirst|wantarray|scalar)\\b",
      "name": "support.class.builtin"
    },
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign"
    },
    "constants": {
      "match": "\\bundef\\b",
      "name": "constant.language"
    },
    "function-declaration": {
      "captures": {
        "1": {
          "name": "storage.type.function"
        },
        "2": {
          "name": "entity.name.function"
        }
      },
      "match": "\\b(sub)\\s+([A-Za-z_]\\w*)"
    },
    "keywords": {
      "match": "\\b(?:my|our|local|sub|if|elsif|else|unless|while|until|for|foreach|do|return|last|next|redo|use|no|package|require|and|or|not|xor|eq|ne|lt|gt|le|ge|cmp|given|when|default)\\b",
      "name": "keyword.control"
    },
    "numbers": {
      "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*)?(?:[eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "(?:=>|->|::|\\.\\.\\.?|<=>|==|!=|<=|>=|&&|\\|\\||//|=~|!~|\\*\\*|[+\\-*/%.!<>=]=?)",
      "name": "keyword.operator"
    },
    "pod": {
      "begin": "^=\\w+",
      "end": "^=cut\\b",
      "name": "comment.block.documentation"
    },
    "strings": {
      "patterns": [
        {
          "match": "qw\\s*\\(([^)]*)\\)",
          "name": "string.quoted.other.qw"
        },
        {
          "match": "'(?:\\\\.|[^'\\\\])*'",
          "name": "string.quoted.single"
        },
        {
          "match": "\"(?:\\\\.|[^\"\\\\])*\"",
          "name": "string.quoted.double"
        },
        {
          "match": "`(?:\\\\.|[^`\\\\])*`",
          "name": "string.interpolated.backtick"
        }
      ]
    },
    "variables": {
      "match": "[$@%&][A-Za-z_]\\w*(?:::\\w+)*|\\$\\{[^}]+\\}|\\$[0-9]+|\\$[!@_/\\\\,.;]",
      "name": "entity.name.variable"
    }
  },
  "scopeName": "source.perl"
}
