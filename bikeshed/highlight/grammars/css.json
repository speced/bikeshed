{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keyframes"
    },
    {
      "include": "#at-rule-block"
    },
    {
      "include": "#at-rule-statement"
    },
    {
      "include": "#rule-set"
    }
  ],
  "repository": {
    "at-rule-block": {
      "begin": "(@(?:container|counter-style|document|font-face|font-feature-values|font-palette-values|layer|media|page|position-try|scope|starting-style|supports|view-transition)\\b)[^{;]*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.at-rule"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "at-rule-statement": {
      "begin": "(@(?:charset|custom-media|import|namespace|property)\\b)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.at-rule"
        }
      },
      "end": ";",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#values"
        }
      ]
    },
    "comments": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block"
    },
    "declarations": {
      "captures": {
        "1": {
          "name": "support.type.property-name"
        }
      },
      "match": "(--[a-zA-Z0-9_-]+|[a-zA-Z-][\\w-]*)(\\s*:)"
    },
    "keyframes": {
      "begin": "(@(?:-\\w+-)?keyframes)\\s+([a-zA-Z_-][\\w-]*)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.at-rule"
        },
        "2": {
          "name": "entity.name.animation"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "rule-set": {
      "begin": "([^\\s@{};<][^@{};<]*?)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "entity.name.selector"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#keyframes"
        },
        {
          "include": "#at-rule-block"
        },
        {
          "include": "#at-rule-statement"
        },
        {
          "include": "#rule-set"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#values"
        }
      ]
    },
    "strings": {
      "match": "(['\"])(?:\\\\.|(?!\\1)[^\\\\\\r\\n])*\\1",
      "name": "string.quoted"
    },
    "values": {
      "patterns": [
        {
          "match": "!important\\b",
          "name": "keyword.other.important"
        },
        {
          "captures": {
            "1": {
              "name": "entity.name.function"
            },
            "2": {
              "name": "variable.other.custom-property"
            }
          },
          "match": "\\b(var)\\(\\s*(--[a-zA-Z0-9_-]+)"
        },
        {
          "captures": {
            "1": {
              "name": "entity.name.function"
            }
          },
          "match": "\\b([a-zA-Z_-][\\w-]*)(?=\\()"
        },
        {
          "match": "#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{4}|[0-9a-fA-F]{3})\\b",
          "name": "constant.other.color"
        },
        {
          "match": "(?<![\\w.-])-?(?:\\d*\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?(?:%|[a-zA-Z]+)?\\b",
          "name": "constant.numeric"
        },
        {
          "match": "\\b(?:auto|currentColor|inherit|initial|none|normal|revert|revert-layer|transparent|unset)\\b",
          "name": "constant.language"
        },
        {
          "match": "(?:[+*/]|(?<=\\s)-(?!-))",
          "name": "keyword.operator"
        }
      ]
    }
  },
  "scopeName": "source.css"
}
