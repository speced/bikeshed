{
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "builtins": {
      "match": "\\b(?:c|list|vector|matrix|data\\.frame|print|cat|paste|paste0|sprintf|nrow|ncol|length|names|colnames|rownames|sapply|lapply|vapply|mapply|apply|Map|Filter|Reduce|library|require|source|setwd|getwd|summary|str|head|tail|is\\.na|is\\.null|as\\.character|as\\.numeric|as\\.integer|as\\.factor|as\\.data\\.frame)\\b",
      "name": "support.class.builtin"
    },
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign"
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:TRUE|FALSE|T|F)\\b",
          "name": "constant.language.boolean"
        },
        {
          "match": "\\b(?:NULL|NA|NA_integer_|NA_real_|NA_character_|NA_complex_|Inf|NaN)\\b",
          "name": "constant.language"
        }
      ]
    },
    "function-declaration": {
      "match": "\\b([A-Za-z_.][\\w.]*)\\s*(?=<-\\s*function\\b|=\\s*function\\b)",
      "name": "entity.name.function"
    },
    "keywords": {
      "match": "\\b(?:if|else|repeat|while|function|for|next|break|in)\\b",
      "name": "keyword.control"
    },
    "numbers": {
      "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F]+|(?:\\d+\\.\\d*|\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?[Li]?)\\b",
      "name": "constant.numeric"
    },
    "operators": {
      "match": "(?:%[^%\\s]*%|<<-|<-|->>|->|==|!=|<=|>=|&&|\\|\\||[-+*/^!<>=&|~?:])",
      "name": "keyword.operator"
    },
    "strings": {
      "patterns": [
        {
          "match": "'(?:\\\\.|[^'\\\\])*'",
          "name": "string.quoted.single"
        },
        {
          "match": "\"(?:\\\\.|[^\"\\\\])*\"",
          "name": "string.quoted.double"
        }
      ]
    }
  },
  "scopeName": "source.r"
}
