<h2 id="xml-test">XML Test</h2>

<pre highlight=xml>
&lt;?xml version="1.0" encoding="UTF-8"?>
&lt;?xml-stylesheet type="text/css" href="style.css"?>
&lt;!DOCTYPE note [
  &lt;!ELEMENT note (to, body)>
  &lt;!ENTITY copy "&amp;#169;">
]>
&lt;!-- A comment -->
&lt;ns:note xmlns:ns="https://example.com/ns" xml:lang="en">
  &lt;ns:to>Alice &amp;amp; Bob&lt;/ns:to>
  &lt;ns:body>&lt;![CDATA[Raw &lt;text> &amp; data]]>&lt;/ns:body>
&lt;/ns:note>
</pre>

<h2 id="asm-test">ASM Alias Test</h2>

<pre highlight=asm>
; Increment and return
main:
  mov rax, 42
  ret
</pre>
