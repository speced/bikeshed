<pre highlight=hs>
-- Factorial in Haskell
fact :: Int -> Int
fact 0 = 1
fact n = n * fact (n - 1)
</pre>

<pre highlight=ocaml>
(* Factorial in OCaml *)
let rec fact n = if n &lt;= 1 then 1 else n * fact (n - 1)
</pre>

