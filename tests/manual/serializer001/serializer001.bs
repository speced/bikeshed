<h2 id="mixed-blocks-and-inlines">Mixed Blocks and Inlines</h2>

<div>leading text <span>inline1</span>
 <p>block1</p>
 middle text <em>inline2</em>
 <p>block2</p>
 <span>inline3</span> trailing text</div>

<div><span>inline first without leading text</span><p>then a block</p></div>

<div>leading text only before block<p>then a block</p>trailing text only after block</div>

<h2 id="dl-dt-dd-omission">DL/DT/DD End Tag Omission</h2>

<dl>
 <dt>term 1</dt>
 <dd>def 1</dd>
 <dt>term 2</dt>
 <dd><p>block def 2</p></dd>
</dl>

<dl>
 <dt>term before div</dt>
 <dd>def before div</dd>
 <div>
  <dt>wrapped term</dt>
  <dd>wrapped def</dd>
 </div>
</dl>

<dl>
 <dt>term before inline</dt>
 <span>inline inside dl</span>
 <dd>def before trailing text</dd>
 trailing text inside dl
</dl>

<h2 id="comments-and-whitespace">Comments and Whitespace</h2>

<div><!-- comment only in empty block -->   </div>

<p>before <!-- inline comment --><b>bold</b><!-- second comment --> after</p>

<div>text before comment <!-- comment --> text after comment<p>block child</p></div>

<dl>
 <dt>term with comment after</dt><!-- comment between dt and dd -->
 <dd>def after comment</dd>
</dl>

<h2 id="attributes-and-svg">Attributes and SVG Case</h2>

<div>no attrs</div>
<div id="single-attr">one attr</div>
<div class="z-class  a-class   m-class">sorted classes</div>
<div title="second" id="first">two attrs sorted</div>
<div id="with-class" class="c b a">two attrs with class</div>
<div data-z="1" data-a="2" class="b a" id="many" hidden="">three+ attrs and boolean attr</div>
<div data-quotes='single &apos; double " amp &amp; lt <'>escaped attr chars</div>

<svg viewbox="0 0 100 100">
 <clippath id="my-clip">
  <rect width="10" height="10"></rect>
 </clippath>
</svg>

<h2 id="custom-and-opaque-and-raw">Custom, Opaque, and Raw Elements</h2>

<p>Paragraph with <custom-inline>inline custom element</custom-inline> inside.</p>

<custom-block>Block custom element with <span>inline child</span></custom-block>

<custom-opaque>
  Custom opaque   whitespace
  <span>and <b>nested</b> inline &amp; &lt;tags></span>
</custom-opaque>

