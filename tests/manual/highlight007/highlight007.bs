<h2 id="cddl-test">CDDL Test</h2>

<pre highlight=cddl>
;# directive = true
; A comment
person = {
  name: tstr,
  age: uint,
  ? email: tstr,
  payload: bstr .size 32,
  hash: h'01020304',
  tag: #6.32(tstr),
  count: 42,
  $socket,
}
