<pre class=metadata>
Group: test
Shortname: test
Level: 1
Status: LS
ED: http://example.com/foo
Editor: Example Editor
Date: 1970-01-01
Title: Meta-language Grammars Highlighting
Abstract: Verifying that ABNF, BNF, EBNF, GOLD, Grammarkdown, Lark, LBNF, Lex, PEG.js, and Yacc highlighting grammars work as expected.
</pre>

<pre highlight=abnf>
; RFC 5234 example
rule = 1*ALPHA / %s"null" / %x20-7E
</pre>

<pre highlight=bnf>
&lt;expr> ::= &lt;term> | &lt;expr> "+" &lt;term>
</pre>

<pre highlight=ebnf>
(* ISO 14977 *)
number = digit, { digit } ;
</pre>

<pre highlight=gold>
! GOLD grammar
"Name" = 'Sample'
&lt;Expr> ::= {Digit}+
</pre>

<pre highlight=grammarkdown>
// Grammarkdown
PrimaryExpression :
  `this`
  IdentifierReference
</pre>

<pre highlight=lark>
// Lark grammar
%import common.WS
start: WORD+
WORD: /[a-z]+/i
</pre>

<pre highlight=lbnf>
-- LBNF
EAdd. Exp ::= Exp "+" Exp ;
</pre>

<pre highlight=lex>
%{
#include &lt;stdio.h>
%}
DIGIT [0-9]
%%
{DIGIT}+  return 1;
%%
int main() { return 0; }
</pre>

<pre highlight=pegjs>
start = a:[a-z]+i { return a.join(""); }
</pre>

<pre highlight=yacc>
%{
int yylex(void);
%}
%token NUMBER
%%
expr: NUMBER { $$ = $1; };
%%
int main(void) { return 0; }
</pre>
